end

-- remote resolution: exact name first, then auto-detect chest remotes.
-- the real game's remote may not be called exactly "OpenChest".
local warnedNoRemote = false
local function resolveRemote()
  local rs = game:GetService("ReplicatedStorage")
  local want = (Flags.RemoteName ~= "" and Flags.RemoteName) or OPEN_REMOTE_NAME
  local direct = rs:FindFirstChild(want, true)
  if direct and (direct.ClassName == "RemoteEvent" or direct.ClassName == "UnreliableRemoteEvent") then
    return direct
  end
  for _, d in ipairs(rs:GetDescendants()) do
    if d.ClassName == "RemoteEvent" or d.ClassName == "UnreliableRemoteEvent" then
      if string.find(string.lower(d.Name), "chest") then return d end
    end
  end
  return nil
end
getRemote = function()
  if openRemote then return openRemote end
  openRemote = resolveRemote()
  if openRemote and console then
    console:Write("Remote: " .. tostring(openRemote.Name))
  end
  return openRemote
end
local function ensureDemoRemote()
  local r = ReplicatedStorage:FindFirstChild(OPEN_REMOTE_NAME)
  if not r then
    r = Instance.new("RemoteEvent")
    r.Name = OPEN_REMOTE_NAME
    r.Parent = ReplicatedStorage
  end
  openRemote = r
end

local function disablePrompts(chest, on)
  for _, d in ipairs(chest:GetDescendants()) do
    if d.ClassName == "ProximityPrompt" then d.Enabled = on end
  end
end

local function refreshCounter()
  if countLabel then
    countLabel:Set("Opened: " .. uniqueOpened .. " / " .. rangeSize() .. " (" .. totalOpens .. " total)")
  end
end

if FALLBACK then
  -- demo "game server" so the full open loop runs inside the mock.
  -- in the real game the actual server owns this logic.
  ensureDemoRemote()
  local demoRem = getRemote()
  if demoRem then
  demoRem.OnServerEvent:Connect(function(player, chest)
    if typeof(chest) ~= "Instance" or not chest.FindFirstChild then
      print("Server: rejected bad request from " .. tostring(player.Name))
      return
    end
    local opened = chest:FindFirstChild("Opened")
    if not opened or opened.Value then
      print("Server: chest " .. tostring(chest.Name) .. " already opened, ignoring")
      return
    end
    -- server-side range check (a real game checks player.Character here)
    local hrp = getHRP()
    local part = chest:FindFirstChild("ChestPart", true)
    if hrp and part then
      if dist3(hrp.Position, part.Position) > 60 then
        print("Server: " .. tostring(player.Name) .. " too far from chest " .. tostring(chest.Name))
        return
      end
    end
    opened.Value = true
    disablePrompts(chest, false)
    local num = tonumber(chest.Name) or 0
    if not openedSet[num] then openedSet[num] = true uniqueOpened = uniqueOpened + 1 end
    totalOpens = totalOpens + 1
    Flags.Collected = totalOpens
    print("Server: opened chest " .. tostring(chest.Name) .. " (" .. uniqueOpened .. " unique)")
    refreshCounter()
    if console then console:Write("Opened chest " .. tostring(chest.Name)) end
  end)
  end
end

