    local function makeDemoChest(i)
      local m = Instance.new("Model")
      m.Name = tostring(i)
      local part = Instance.new("Part")
      part.Name = "ChestPart"
      part.Position = Vector3.new(-60 + i * 16, 3, (i % 2) * 30 - 15)
      part.Anchored = true
      part.Parent = m
      local opened = Instance.new("BoolValue")
      opened.Name = "Opened"
      opened.Value = false
      opened.Parent = m
      local prompt = Instance.new("ProximityPrompt")
      prompt.HoldDuration = 0.5
      prompt.MaxActivationDistance = 10
      prompt.Parent = part
      prompt.Triggered:Connect(function() opened.Value = true end)
      return m
    end
    for i = 1, 8 do makeDemoChest(i).Parent = workspace end
    print("Demo: 8 chests placed (stand-ins for your 1..54).")
    local savedFrom, savedTo = Flags.From, Flags.To
