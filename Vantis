-- pin the character mid-air. anchoring the HRP is what stops the fall
-- between teleports; velocities are zeroed so there is no drift.
-- never throws. call with false to hand physics back (Land button,
-- farm toggle off). the loop re-anchors on every teleport, so a
-- respawned character gets pinned again on the next pass.
local function setFloat(on)
  if not on then
    pcall(function() if activeTween ~= nil then activeTween:Cancel() end end)
    activeTween = nil
  end
  local hrp = getPlayerHRP()
  if hrp then
    pcall(function() hrp.Anchored = on end)
    pcall(function() hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
    pcall(function() hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0) end)
    pcall(function() hrp.Velocity = Vector3.new(0, 0, 0) end)
    pcall(function() hrp.RotVelocity = Vector3.new(0, 0, 0) end)
  end
  local hum = getHumanoid()
  if hum then
    pcall(function() hum.PlatformStand = on end)
  end
end

-- float position pose for the farm pin. Above = overhead looking down,
-- Behind = 3 studs behind the NPC (its facing, world +Z fallback) at
-- hover height facing it, Below = underneath looking up. mock-safe
-- (no CFrame*Vector3, yaw via two-arg atan).
local function modeLabel()
  if floatPos == "Behind" then return "3 studs behind" end
  if floatPos == "Below" then return "below" end
  return "above"
end

local function hoverPose(rp)
  local h = Flags.NpcHeight or 5
  if floatPos == "Behind" then
    local lx, lz = 0, 1
    pcall(function()
      local lv = rp.CFrame.LookVector
      if lv ~= nil and lv.X ~= nil then lx, lz = lv.X, lv.Z end
    end)
    local len = math.sqrt(lx * lx + lz * lz)
    if len > 0.001 then lx, lz = lx / len, lz / len end
    local px = rp.Position.X - lx * 3
    local pz = rp.Position.Z - lz * 3
    local yaw = 0
    pcall(function()
      yaw = math.atan(-(rp.Position.X - px), -(rp.Position.Z - pz))
    end)
    return CFrame.new(px, rp.Position.Y + h, pz) * CFrame.Angles(0, yaw, 0)
  end
  if floatPos == "Below" then
    return CFrame.new(rp.Position.X, rp.Position.Y - h, rp.Position.Z)
      * CFrame.Angles(math.rad(90), 0, 0)
  end
  return CFrame.new(rp.Position.X, rp.Position.Y + h, rp.Position.Z)
    * CFrame.Angles(math.rad(-90), 0, 0)
end

-- noclip while farming so glides/teleports never snag on walls.
-- Infinite-Yield-style: a Stepped loop keeps every part non-collidable
-- (respawned characters and newly added parts included), not just a
-- one-shot pass. Land / toggle-off disconnects and restores collisions.
-- never throws.
local noclipOn = false
local noclipConn = nil

local function isNoclipPart(d)
  local ok, res = pcall(function() return d:IsA("BasePart") end)
  if ok and res then return true end
  local cn = nil
  pcall(function() cn = d.ClassName end)
  return cn == "Part" or cn == "MeshPart"
end

local function noclipTick()
  if not noclipOn then return end
  local char = nil
  pcall(function() if LP then char = LP.Character end end)
  if char == nil then return end
  pcall(function()
    for _, d in ipairs(char:GetDescendants()) do
      if isNoclipPart(d) then
        pcall(function() d.CanCollide = false end)
      end
    end
  end)
end

local function setNoclip(on)
  noclipOn = on
  pcall(function()
    if noclipConn ~= nil then noclipConn:Disconnect() end
  end)
  noclipConn = nil
  if on then
    noclipTick()
    pcall(function()
      if RunService ~= nil then
        local sig = RunService.Stepped or RunService.Heartbeat
        if sig ~= nil then noclipConn = sig:Connect(noclipTick) end
      end
    end)
  else
    local char = nil
    pcall(function() if LP then char = LP.Character end end)
    if char ~= nil then
      pcall(function()
        for _, d in ipairs(char:GetDescendants()) do
          if isNoclipPart(d) then
            pcall(function() d.CanCollide = true end)
          end
        end
      end)
    end
  end
end

-- Infinite-Yield anti-afk pattern: idle kicks end long farms, so the
-- farm toggle disables the LocalPlayer Idled connections once per
-- session. executor-only (needs getconnections); logs plainly when the
-- executor lacks it. never throws.
local antiAfkDone = false
local function ensureAntiAfk()
  if antiAfkDone then return end
  antiAfkDone = true
  local done = false
  pcall(function()
    local GC = getconnections or get_signal_cons
    if GC ~= nil and LP ~= nil and LP.Idled ~= nil then
      local cons = GC(LP.Idled)
      if cons ~= nil then
        for _, c in ipairs(cons) do
          pcall(function()
            if c.Disable ~= nil then c:Disable()
            elseif c.Disconnect ~= nil then c:Disconnect() end
          end)
        end
        done = true
      end
    end
  end)
  if done then say("Anti-AFK on (idle kick blocked)")
  else say("Anti-AFK unavailable here (needs getconnections)") end
end

-- teleports the player to the current float pose + pins. Instant snaps,
-- Glide flies there (~150 studs/s) so servers that reject teleports
-- (rubber-band: you look stuck while the log says otherwise) still
-- accept the move. verifies arrival - unanchored drifting or a server
-- pull-back reads as false. never throws.
local function pinTo(rp)
  local hrp = getPlayerHRP()
  if hrp == nil or rp == nil or rp.Position == nil then return false end
  -- Infinite-Yield goto pattern: stand up first, or a seat weld keeps
  -- dragging the character back to the chair after the teleport.
  local wasSeated = false
  pcall(function()
    local hum = getHumanoid()
    if hum ~= nil and hum.SeatPart ~= nil then
      hum.Sit = false
      wasSeated = true
    end
  end)
  if wasSeated then pcall(function() task.wait(0.1) end) end
  local cf = hoverPose(rp)
  if Flags.FarmMethod == "Glide" then
    setFloat(false)
    local glided = false
    pcall(function()
      if TweenService ~= nil and TweenService.Create ~= nil then
        local dist = 0
        pcall(function() dist = (cf.Position - hrp.CFrame.Position).Magnitude end)
        local t = math.max(dist / 150, 0.1)
        activeTween = TweenService:Create(hrp, TweenInfo.new(t, Enum.EasingStyle.Linear), {CFrame = cf})
        activeTween:Play()
        task.wait(t + 0.1)
        activeTween = nil
        glided = true
      end
    end)
    if not glided then
      pcall(function() hrp.CFrame = cf end)
    end
  else
    pcall(function() hrp.CFrame = cf end)
  end
  setFloat(true)
  task.wait(0.2)
  local d = nil
  pcall(function()
    if hrp.Position ~= nil then d = (hrp.Position - cf.Position).Magnitude end
  end)
  return d ~= nil and d <= 8
end

-- pin with one automatic glide retry when the server rejects the
-- position. returns arrival. never throws.
local function pinVerified(rp, name)
  if pinTo(rp) then return true end
  say("Position rejected (" .. name .. ") - retrying as glide...")
  local old = Flags.FarmMethod
  Flags.FarmMethod = "Glide"
  local ok = pinTo(rp)
  Flags.FarmMethod = old
  if not ok then
    say("Still stuck at " .. name .. " - Land, move manually, or set Move Method to Glide")
  end
  return ok
end

-- mobile-to-PC skill map (from the phone HUD: Punch / Secondary buttons
-- plus the Ability 1-6 circles and the 1-6 hotbar underneath them).
local MOBILE_BUTTON = {
  M1 = "Punch", M2 = "Secondary",
  E = "Ability 1", R = "Ability 2", G = "Ability 3",
  C = "Ability 4", X = "Ability 5", V = "Ability 6",
}
local mobileBtnCache = {}
local touchReported = false

local function normBtn(s)
  s = string.lower(s or "")
  return (string.gsub(s, "[^%a%d]", ""))
end

local function isBtn(d)
  local ok, res = pcall(function()
    return d:IsA("TextButton") or d:IsA("ImageButton")
  end)
  return ok and res
end

-- finds the touch button for a skill, cached, rescans when the HUD rebuilds.
-- returns nil on PC (no touch buttons) so callers fall back to keys.
local function findMobileButton(skillKey)
  local want = MOBILE_BUTTON[skillKey]
  if want == nil then return nil end
  local cached = mobileBtnCache[skillKey]
  if cached ~= nil then
    local alive = false
    pcall(function() alive = cached.Parent ~= nil end)
    if alive then return cached end
    mobileBtnCache[skillKey] = nil
  end
  local pg = nil
  pcall(function()
    if LP.FindFirstChildOfClass then pg = LP:FindFirstChildOfClass("PlayerGui") end
  end)
  if pg == nil then
    pcall(function() pg = LP:FindFirstChild("PlayerGui") end)
  end
  if pg == nil then return nil end
  local desc = nil
  pcall(function() desc = pg:GetDescendants() end)
  if desc == nil then return nil end
  local wantNorm = normBtn(want)
  local fallback = nil
  for _, d in ipairs(desc) do
    if isBtn(d) then
      local name = ""
      pcall(function() name = normBtn(d.Name) end)
      local text = ""
      pcall(function() text = normBtn(d.Text) end)
      local vis = true
      pcall(function() vis = d.Visible end)
      if vis and (name == wantNorm or text == wantNorm) then
        -- exact ability hits win over bare-number hotbar text ("1")
        if name:find("ability", 1, true) then
          mobileBtnCache[skillKey] = d
          if not touchReported then
            touchReported = true
            say("Touch controls found - tapping on-screen buttons")
          end
          return d
        elseif fallback == nil then
          fallback = d
        end
      end
    end
  end
  if fallback ~= nil then
    mobileBtnCache[skillKey] = fallback
    if not touchReported then
      touchReported = true
      say("Touch controls found - tapping on-screen buttons")
    end
  end
  return fallback
end

-- taps (or holds) a touch button: firesignal when the executor has it,
-- else a VirtualUser tap at the button's screen center. returns true if
-- anything was sent. never throws.
local function tapButton(btn, holdSecs)
  local vu = nil
  pcall(function() vu = game:GetService("VirtualUser") end)
  local center = nil
  pcall(function()
    local p = btn.AbsolutePosition
    local s = btn.AbsoluteSize
    center = Vector2.new(p.X + s.X / 2, p.Y + s.Y / 2)
  end)
  local cam = nil
  pcall(function() cam = workspace.CurrentCamera end)
  if holdSecs ~= nil and holdSecs > 0 then
    local held = false
    pcall(function()
      if firesignal then
        if center then
          firesignal(btn.MouseButton1Down, center.X, center.Y)
        else
          firesignal(btn.MouseButton1Down)
        end
        held = true
      end
    end)
    if held then
      task.wait(holdSecs)
      pcall(function()
        if center then
          firesignal(btn.MouseButton1Up, center.X, center.Y)
        else
          firesignal(btn.MouseButton1Up)
        end
      end)
      return true
    end
    if vu ~= nil and center ~= nil then
      local down = pcall(function()
        if cam then vu:Button1Down(center, cam) else vu:Button1Down(center) end
      end)
      if down then
        task.wait(holdSecs)
        pcall(function()
          if cam then vu:Button1Up(center, cam) else vu:Button1Up(center) end
        end)
        return true
      end
    end
    return false
  end
  local sigged = false
  pcall(function()
    if firesignal then firesignal(btn.Activated) sigged = true end
  end)
  if sigged then return true end
  if vu ~= nil and center ~= nil then
    local tapped = pcall(function()
      if cam then vu:ClickButton1(center, cam) else vu:ClickButton1(center) end
    end)
    if tapped then return true end
  end
  return false
end

-- one-shot input status line so a real executor tells the truth: if the
-- executor blocks VirtualInputManager, key/mouse presses can never land
-- and the log says so instead of silently doing nothing.
local inputReported = false
local function reportInput(vim)
  if inputReported then return end
  inputReported = true
  if vim then
    say("Input: VirtualInputManager ready")
  else
    say("Input: no VirtualInputManager (mock has no input - in game this means the executor blocked it)")
  end
  pcall(function()
    if mouse1click then say("Input: mouse1click fallback available") end
  end)
end

-- shared input primitives (rotation + combo both use these).
local cachedVim = "none"
local function getVim()
  if cachedVim == "none" then
    cachedVim = nil
    pcall(function() cachedVim = game:GetService("VirtualInputManager") end)
    reportInput(cachedVim)
  end
  return cachedVim
end

local function vimClick()
  local vim = getVim()
  if vim then
    local ok = pcall(function()
      vim:SendMouseButtonEvent(500, 500, 0, true, game, 0)
      task.wait(0.1)
      vim:SendMouseButtonEvent(500, 500, 0, false, game, 0)
    end)
    if ok then return end
  end
  pcall(function()
    if mouse1click then
      mouse1click()
    elseif mouse1press and mouse1release then
      mouse1press()
      task.wait(0.1)
      mouse1release()
    end
  end)
end

-- M2 / Secondary is a DOUBLE right click in-game (wiki Basics page).
local function vimRightClick()
  local vim = getVim()
  if vim then
    pcall(function()
      for _ = 1, 2 do
        vim:SendMouseButtonEvent(500, 500, 1, true, game, 0)
        task.wait(0.1)
        vim:SendMouseButtonEvent(500, 500, 1, false, game, 0)
        task.wait(0.15)
      end
    end)
  end
end

local function keyDown(code)
  local vim = getVim()
  if vim then
    local ok = pcall(function() vim:SendKeyEvent(true, code, false, game) end)
    if ok then return true end
  end
  local keyVal = code
  pcall(function() if code.Value ~= nil then keyVal = code.Value end end)
  local pressed = false
  pcall(function()
    if keypress then keypress(keyVal) pressed = true end
  end)
  return pressed
end

local function keyUp(code)
  local vim = getVim()
  if vim then
    pcall(function() vim:SendKeyEvent(false, code, false, game) end)
    return
  end
  local keyVal = code
  pcall(function() if code.Value ~= nil then keyVal = code.Value end end)
  pcall(function()
    if keyrelease then keyrelease(keyVal) end
  end)
end

local TAP_KEYS = { R = Enum.KeyCode.R, G = Enum.KeyCode.G,
  C = Enum.KeyCode.C, X = Enum.KeyCode.X, V = Enum.KeyCode.V }

local function tapPc(skillKey)
  if skillKey == "M1" then
    vimClick()
  elseif skillKey == "M2" then
    vimRightClick()
  else
    local code = TAP_KEYS[skillKey]
    if code ~= nil then
      keyDown(code)
      task.wait(0.15)
      keyUp(code)
    end
  end
end

-- single tap through touch buttons (mobile) or keys (PC). honors the
-- Farm multi-select. Common-stand toggle skips V. never throws.
local function doTapSkill(skillKey)
  if not Flags.Skills[skillKey] then return end
  if skillKey == "V" and Flags.NoV then
    say("Skill: V skipped (Common stand)")
    return
  end
  local btn = findMobileButton(skillKey)
  if btn ~= nil then
    if tapButton(btn) then
      say("Skill: " .. skillKey .. " (touch)")
      return
    end
    say("Skill: " .. skillKey .. " (touch blocked, trying keys)")
  elseif touchReported then
    say("Skill: " .. skillKey .. " (no touch button mapped)")
  end
  tapPc(skillKey)
  say("Skill: " .. skillKey)
end

-- E hold 3s through touch (Ability 1) or key. honors multi-select.
local function fireEHold()
  if not Flags.Skills.E then return end
  local btn = findMobileButton("E")
  if btn ~= nil then
    if tapButton(btn, 3) then
      say("Skill: E hold (3s, touch)")
    else
      say("Skill: E hold (touch blocked, trying key)")
      keyDown(Enum.KeyCode.E)
      task.wait(3)
      keyUp(Enum.KeyCode.E)
      say("Skill: E hold (3s)")
    end
  else
    keyDown(Enum.KeyCode.E)
    say("Skill: E hold (3s)...")
    task.wait(3)
    keyUp(Enum.KeyCode.E)
  end
end

-- visible-but-transparent overlays are not real cooldowns.
local function overlayShowing(d)
  local vis = true
  pcall(function() vis = d.Visible end)
  if not vis then return false end
  local seen, opaque = false, false
  pcall(function()
    local t = d.BackgroundTransparency
    if type(t) == "number" then
      seen = true
      if t < 0.99 then opaque = true end
    end
  end)
  pcall(function()
    local t = d.ImageTransparency
    if type(t) == "number" then
      seen = true
      if t < 0.99 then opaque = true end
    end
  end)
  pcall(function()
    local t = d.TextTransparency
    if type(t) == "number" then
      seen = true
      if t < 0.99 then opaque = true end
    end
  end)
  if not seen then return true end
  return opaque
end

-- true when the skill's button shows a cooldown (named overlay, or a
-- numbered countdown label). static hotbar key numbers are ignored:
-- only cooldown/timer-ish names count. never throws.
local function onCooldown(skillKey)
  local btn = findMobileButton(skillKey)
  if btn == nil then return false end
  local cooling = false
  pcall(function()
    for _, d in ipairs(btn:GetDescendants()) do
      local nm = ""
      pcall(function() nm = string.lower(d.Name or "") end)
      if nm:find("cooldown", 1, true) then
        if overlayShowing(d) then
          local txt = nil
          pcall(function() txt = d.Text end)
          local num = tonumber(txt or "")
          if num == nil or num > 0 then cooling = true end
        end
      elseif nm:find("timer", 1, true) or nm:find("remaining", 1, true) or nm:find("counter", 1, true) or nm == "cd" then
        local txt = nil
        pcall(function() txt = d.Text end)
        local num = tonumber(txt or "")
        if num ~= nil and num > 0 then
          if overlayShowing(d) then cooling = true end
        end
      end
      if cooling then break end
    end
  end)
  return cooling
end

-- combo gate: multi-select off or Common-stand V = silent skip,
-- cooling = skip + log.
local function comboReady(skillKey)
  if not Flags.Skills[skillKey] then return false end
  if skillKey == "V" and Flags.NoV then return false end
  if onCooldown(skillKey) then
    say("Combo: " .. skillKey .. " on cooldown, skipping")
    return false
  end
  return true
end

-- Auto Combo: 3x M1, E hold, 3x M1, R, G (or V), C, X.
-- cooling skills skip, the rest of the combo keeps going.
local function runCombo()
  say("Combo: 3x M1, E hold, 3x M1, R, G/V, C, X (cooling skips)")
  for i = 1, 3 do
    if comboReady("M1") then doTapSkill("M1") end
    task.wait(0.25)
  end
  if comboReady("E") then fireEHold() end
  task.wait(0.3)
  for i = 1, 3 do
    if comboReady("M1") then doTapSkill("M1") end
    task.wait(0.25)
  end
  if comboReady("R") then doTapSkill("R") end
  task.wait(0.2)
  if comboReady("G") then
    doTapSkill("G")
  else
    local vFire = Flags.Skills.V and not onCooldown("V")
    if vFire then
      if Flags.Skills.G then say("Combo: G on cooldown, using V instead") end
      doTapSkill("V")
    elseif Flags.Skills.V then
      say("Combo: V on cooldown, skipping")
    end
  end
  task.wait(0.2)
  if comboReady("C") then doTapSkill("C") end
  task.wait(0.2)
  if comboReady("X") then doTapSkill("X") end
  say("Combo: done")
end

-- skill rotation after each teleport. only fires skills enabled in
-- Flags.Skills (Farm tab multi-select). on mobile each skill taps its
-- on-screen button (Punch / Secondary / Ability N, E holds Ability 1);
-- on PC it fires through VirtualInputManager with mouse1click /
-- keypress fallbacks. the editor mock has no input service, so it
-- just logs the rotation. never throws.
local function useSkills()
  local any = false
  for _, k in ipairs(SKILL_LIST) do
    if Flags.Skills[k] then any = true break end
  end
  if not any then
    say("Skills: none selected, skipping rotation")
    return
  end
  getVim() -- warms input + prints the one-shot status line
  doTapSkill("M1")
  doTapSkill("M2")
  fireEHold()
  for _, key in ipairs({"R", "G", "C", "X", "V"}) do
    doTapSkill(key)
  end
end

-- rotation entry: combo when the toggle is on, plain rotation otherwise.
local function fireRotation()
  if Flags.Combo then
    runCombo()
  else
    useSkills()
  end
end

-- increments whenever follow mode must stop (toggle off, Land, new lock).
local followToken = 0

-- background pin loop: re-teleports above the same NPC root every 0.1s
-- so a walking NPC can't leave you behind. stops when the token dies.
local function keepPin(name, myToken, getRp)
  task.spawn(function()
    while Flags.NpcFarm and npcTarget == name and followToken == myToken do
      pinTo(getRp())
      task.wait(0.1)
    end
  end)
end

-- bosses respawn every 1-3 min, mobs every 15-30s: wait longer on a
-- missing boss so the loop doesn't spam rescans. never throws.
local function respawnWait(name)
  local info = NPC_INFO[name]
  if info ~= nil and info.boss then return 5 end
  return 1.5
end

-- single-target mode: lock one NPC, glue above it, spam the rotation
-- until it dies/leaves, the target changes, or the toggle goes off.
local function followTarget(name)
  local npc = findNpcByName(name)
  if npc == nil then
    setStatus("Status: " .. name .. " not found")
    say("NPC farm: " .. name .. " not found, waiting for spawn...")
    return 0
  end
  followToken = followToken + 1
  local myToken = followToken
  say("Locked onto " .. name .. " - following + skill spam (toggle off or Land to stop)")
  setStatus("Status: locked " .. name)
  setNoclip(true)
  if npc ~= nil then
    local rp0 = rootPartOf(npc)
    if rp0 ~= nil then pinVerified(rp0, name) end
  end
  keepPin(name, myToken, function()
    if npc == nil then return nil end
    return rootPartOf(npc)
  end)
  local cycles = 0
  while Flags.NpcFarm and npcTarget == name and followToken == myToken do
    if npc == nil or not isAlive(npc) then
      say("NPC farm: " .. name .. " down or gone - rescanning...")
      npc = findNpcByName(name)
      if npc == nil then
        task.wait(respawnWait(name))
        if Flags.NpcFarm and npcTarget == name then
          npc = findNpcByName(name)
        end
        if npc == nil then break end
      end
    else
      cycles = cycles + 1
      fireRotation()
      task.wait(0.3)
    end
  end
  if farmCount then
    pcall(function() farmCount:Set("NPCs: " .. (cycles > 0 and 1 or 0)) end)
  end
  say("Unlocked " .. name .. " (" .. cycles .. " rotations)")
  return cycles > 0 and 1 or 0
end

-- one teleport + one rotation, no loop (Go button / single sweep hit).
local function visitOnce(name)
  local hrp = getPlayerHRP()
  if hrp == nil then
    setStatus("Status: waiting for character...")
    say("NPC farm: no character yet")
    return 0
  end
  setNoclip(true)
  local npc = findNpcByName(name)
  if npc == nil then
    say("NPC farm: " .. name .. " not found, skipping")
    return 0
  end
  if not isAlive(npc) then
    say("NPC farm: " .. name .. " down, skipping")
    return 0
  end
  local rp = rootPartOf(npc)
  if rp == nil or rp.Position == nil then
    say("NPC farm: " .. name .. " has no position, skipping")
    return 0
  end
  pinVerified(rp, name)
  task.wait(0.25)
  setStatus("Status: " .. modeLabel() .. " " .. name)
  say("Hovering " .. modeLabel() .. " " .. name .. " (pinned)")
  fireRotation()
  task.wait(0.5)
  return 1
end

-- one pass over the current NPC target. returns npcs visited.
local function farmNpcsOnce()
  local hrp = getPlayerHRP()
  if hrp == nil then
    setStatus("Status: waiting for character...")
    say("NPC farm: no character yet")
    return 0
  end
  -- single target: lock + follow while the toggle is on, one visit for Go.
  if npcTarget ~= "All" then
    if Flags.NpcFarm then
      return followTarget(npcTarget)
    end
    return visitOnce(npcTarget)
  end
  local targets = {}
  if npcTarget == "All" then
    for _, n in ipairs(NPC_LIST) do targets[#targets + 1] = n end
  else
    targets[1] = npcTarget
  end
  local visited = 0
  for _, name in ipairs(targets) do
    local npc = findNpcByName(name)
    if npc == nil then
      say("NPC farm: " .. name .. " not found, skipping")
    elseif not isAlive(npc) then
      say("NPC farm: " .. name .. " down, skipping")
    else
      local rp = rootPartOf(npc)
      if rp and rp.Position then
        -- hover at the chosen float pose, pinned so there is no falling
        -- between teleports. verified: a server pull-back retries as glide.
        if pinVerified(rp, name) then
          task.wait(0.25)
          visited = visited + 1
          setStatus("Status: " .. modeLabel() .. " " .. name .. " (" .. visited .. ")")
          say("Hovering " .. modeLabel() .. " " .. name .. " (pinned)")
          fireRotation()
          task.wait(0.5)
        else
          task.wait(0.5)
        end
      end
    end
  end
  if visited == 0 then
    setStatus("Status: no NPCs found")
  else
    setStatus("Status: hovering (" .. visited .. " npc)")
  end
  if farmCount then
    pcall(function() farmCount:Set("NPCs: " .. visited) end)
  end
  say("NPCs: " .. visited)
  return visited
end

-- Chest collecting core (ported from the chest-collector module):
-- strict numeric order From -> To, prompt-first (fireproximityprompt, so
-- the game's own server script runs - no remote name guessing), remote
-- fallback, streaming memory, max 3 tries per chest. never throws.
local sweepToken = 0

-- any sweep carrying an old token must stop at its next checkpoint.
-- nil token = no cancellation (demo / one-off calls).
local function cancelled(myToken)
  return myToken ~= nil and myToken ~= sweepToken
end

local memory = {}      -- [num] = last seen position (for unstreamed chests)
local lastSeen = {}    -- nums present in the latest scan
local openedSet = {}   -- nums opened at least once
local uniqueOpened = 0
local totalOpens = 0
local warnedNoRemote = false
local openRemote = nil
local openRemoteCheckedAt = 0

local function updateChestCount()
  local range = math.max(1, Flags.To - Flags.From + 1)
  local msg = "Opened: " .. uniqueOpened .. " / " .. range .. " (" .. totalOpens .. " total)"
  if chestCount then pcall(function() chestCount:Set(msg) end) end
  print(msg)
end

-- player root for chest travel: Serene's farm-grade lookup (HRP ->
-- UpperTorso -> Torso fallback chain). nil = no character yet.
local function chestHRP()
  return getPlayerHRP()
end

local function isCrateName(name)
  if type(name) ~= "string" then return false end
  return string.find(string.lower(name), "crate", 1, true) ~= nil
end

local function dist3(a, b)
  local dx = a.X - b.X
  local dy = a.Y - b.Y
  local dz = a.Z - b.Z
  return math.sqrt(dx * dx + dy * dy + dz * dz)
end

-- cache: [num] = { model=, prompt=, opened=, part= }
local cache = {}
local cacheReady = false

local function firstOf(model, className)
  for _, x in ipairs(model:GetDescendants()) do
    if x.ClassName == className then return x end
  end
  return nil
end

local function modelOf(node)
  local cur = node
  for _ = 1, 4 do
    if cur == nil then return nil end
    if cur.ClassName == "Model" then
      if isCrateName(cur.Name) then return nil end -- a prompt inside a Crate belongs to the crate: leave it alone
      if tonumber(cur.Name) then return cur end
    end
    if cur.Name and tonumber(cur.Name) and cur.FindFirstChild then
      local ok, has = pcall(function() return cur:FindFirstChild("Opened") end)
      if ok and has then return cur end
    end
    cur = cur.Parent
  end
  return nil
end

local function entryFor(model)
  if model == nil then return nil end
  if isCrateName(model.Name) then return nil end -- crates are never chests
  local num = tonumber(model.Name)
  if not num then return nil end
  local prompt = firstOf(model, "ProximityPrompt")
  if not prompt then return nil end
  local part = model:FindFirstChild("ChestPart", true) or firstOf(model, "Part")
  if not part then part = prompt.Parent end
  local opened = nil
  pcall(function() opened = model:FindFirstChild("Opened") end)
  return { model = model, num = num, prompt = prompt, part = part, opened = opened }
end

local function cacheAdd(model)
  local e = entryFor(model)
  if e then cache[e.num] = e end
end

local function buildCache()
  cache = {}
  local all = workspace:GetDescendants()
  for _, d in ipairs(all) do
    if d.ClassName == "ProximityPrompt" then
      local m = modelOf(d)
      if m then cacheAdd(m) end
    end
  end
  -- also accept numeric models even if prompt search missed
  for _, d in ipairs(all) do
    if d.ClassName == "Model" and tonumber(d.Name) then
      local n = tonumber(d.Name)
      if cache[n] == nil then cacheAdd(d) end
    end
  end
  local n = 0
  for _ in pairs(cache) do n = n + 1 end
  say("Chest cache: " .. n .. " chests tracked")
end

local function registerCacheHandlers()
  if cacheReady then return end
  cacheReady = true
  workspace.DescendantAdded:Connect(function(d)
    if d.ClassName == "ProximityPrompt" then
      local m = modelOf(d)
      if m then cacheAdd(m) end
    elseif d.ClassName == "Model" and tonumber(d.Name) then
      cacheAdd(d)
    end
  end)
  workspace.DescendantRemoving:Connect(function(d)
    if d.ClassName == "Model" and tonumber(d.Name) then
      local n = tonumber(d.Name)
      cache[n] = nil
    end
  end)
end

local function ensureCache()
  if not cacheReady then buildCache() registerCacheHandlers() end
end

-- fresh lookup for ONE number: cache first, then a full scan (handles folders).
local function findChestByNum(num)
  ensureCache()
  local e = cache[num]
  if e and e.model.Parent ~= nil and e.prompt and e.prompt.Parent ~= nil then
    if e.part and e.part.Position then
      memory[num] = e.part.Position
      lastSeen[num] = true
      return e
    end
  end
  -- single pass over the workspace (one GetDescendants, not two): prompt
  -- matches win immediately, a bare numbered model is the fallback.
  local plain = nil
  for _, d in ipairs(workspace:GetDescendants()) do
    if d.ClassName == "ProximityPrompt" then
      local m = modelOf(d)
      if m and tonumber(m.Name) == num then
        cacheAdd(m)
        local e2 = cache[num]
        if e2 and e2.part and e2.part.Position then
          memory[num] = e2.part.Position
          lastSeen[num] = true
          return e2
        end
        return e2
      end
    elseif plain == nil and d.ClassName == "Model" and tonumber(d.Name) == num then
      plain = d
    end
  end
  if plain ~= nil then
    cacheAdd(plain)
    local e2 = cache[num]
    if e2 then
      if e2.part and e2.part.Position then memory[num] = e2.part.Position end
      lastSeen[num] = true
      return e2
    end
    return entryFor(plain)
  end
  return nil
end

local function isOpened(e)
  if e == nil then return false end
  if e.opened and e.opened.Value == true then return true end
  -- re-read in case the value instance changed
  local ok, o = pcall(function() return e.model:FindFirstChild("Opened") end)
  if ok and o and o.Value == true then
    e.opened = o
    return true
  end
  if e.prompt and e.prompt.Enabled == false then
    -- disabled prompt usually means already taken; treat as done so we move on
    return true
  end
  return false
end

-- remote resolution: exact name first, then auto-detect chest remotes.
local function resolveRemote()
  local want = (Flags.RemoteName ~= "" and Flags.RemoteName) or "OpenChest"
  local okRs, rs = pcall(function() return game:GetService("ReplicatedStorage") end)
  if not okRs or not rs then return nil end
  local direct = rs:FindFirstChild(want, true)
  if direct and (direct.ClassName == "RemoteEvent" or direct.ClassName == "UnreliableRemoteEvent" or direct.ClassName == "RemoteFunction") then
    return direct
  end
  for _, d in ipairs(rs:GetDescendants()) do
    if d.ClassName == "RemoteEvent" or d.ClassName == "UnreliableRemoteEvent" then
      local nm = string.lower(d.Name)
      if string.find(nm, "chest") or string.find(nm, "open") or string.find(nm, "loot") then return d end
    end
  end
  return nil
end

local function getRemote()
  if openRemote and openRemote.Parent ~= nil then return openRemote end
  -- negative cache: a missing remote rescans ReplicatedStorage every chest
  -- try (54 scans per sweep in prompt-only mode). re-check every 30s.
  local now = tick()
  if openRemote == nil and now - openRemoteCheckedAt < 30 then return nil end
  openRemote = resolveRemote()
  openRemoteCheckedAt = now
  if openRemote then say("Remote: " .. tostring(openRemote.Name)) end
  return openRemote
end

-- instant collect core: zero the hold time, then fire the prompt itself.
-- never throws. returns true if a fire was attempted.
local function holdPrompt(prompt)
  pcall(function()
    prompt.HoldDuration = 0
    prompt.MaxActivationDistance = 1000
    prompt.RequiresLineOfSight = false
    prompt.Enabled = true
  end)
  if typeof(fireproximityprompt) == "function" then
    local ok = pcall(fireproximityprompt, prompt)
    if ok then return true end
  end
  if prompt.Triggered and typeof(prompt.Triggered.Fire) == "function" then
    pcall(function() prompt.Triggered:Fire(LP) end)
    return true
  end
  -- last resort: InputHoldBegin/End (some executors expose these)
  pcall(function()
    if prompt.InputHoldBegin then prompt:InputHoldBegin() end
  end)
  task.wait(0.1)
  pcall(function()
    if prompt.InputHoldEnd then prompt:InputHoldEnd() end
  end)
  return true
end

local function tryRemoteFallback(chestModel, num, attempt)
  local rem = getRemote()
  if not rem then
    if not warnedNoRemote then
      say("No chest remote found - prompt-only mode (this is fine, game server handles the prompt)")
      warnedNoRemote = true
    end
    return
  end
  -- one payload per attempt so the server log stays clean:
  -- try 1 = chest model (most common), try 2 = number, try 3 = string.
  -- the prompt fire above is always tried first; this is only a fallback.
  if rem.ClassName == "RemoteFunction" then
    pcall(function() rem:InvokeServer(chestModel) end)
    return
  end
  if attempt == 2 then
    pcall(function() rem:FireServer(num) end)
  elseif attempt == 3 then
    pcall(function() rem:FireServer(tostring(num)) end)
  else
    pcall(function() rem:FireServer(chestModel) end)
  end
end

local function gotoChest(pos, method, myToken)
  local hrp = chestHRP()
  if not hrp then return false end
  if cancelled(myToken) then return false end
  if method == "Tween" then
    local from = hrp.Position
    for i = 1, 10 do
      if cancelled(myToken) then return false end
      local t = i / 10
      hrp.CFrame = CFrame.new(
        from.X + (pos.X - from.X) * t,
        from.Y + (pos.Y - from.Y) * t + 3,
        from.Z + (pos.Z - from.Z) * t)
      task.wait(0.05)
    end
  else
    hrp.CFrame = CFrame.new(pos.X, pos.Y + 3, pos.Z)
  end
  return true
end

-- walk back to a remembered chest whose area isn't rendered.
local function visitRemembered(num, pos, myToken)
  if cancelled(myToken) then setStatus("Status: stopped") return nil end
  local hrp = chestHRP()
  if not hrp then return nil end
  setStatus("Status: [" .. num .. "] area not rendered, walking back...")
  hrp.CFrame = CFrame.new(pos.X, pos.Y + 3, pos.Z)
  if typeof(LP.RequestStreamAroundAsync) == "function" then
    pcall(function() LP:RequestStreamAroundAsync(pos) end)
  end
  -- same ~5s coverage with half the full-workspace rescans (each miss
  -- walks the whole workspace, so fewer, slower retries cost less CPU).
  for _ = 1, 5 do
    if cancelled(myToken) then setStatus("Status: stopped") return nil end
    task.wait(1)
    if cancelled(myToken) then setStatus("Status: stopped") return nil end
    local e = findChestByNum(num)
    if e and e.prompt and e.part and e.part.Position then
      say("Chest " .. num .. " streamed in")
      return e
    end
  end
  say("Chest " .. num .. " did not stream in, will retry later")
  return nil
end

-- collect ONE numbered chest. always moves on after MaxTries. returns true if opened.
local function collectOneNum(num, myToken)
  if cancelled(myToken) then setStatus("Status: stopped") return false end
  local e = findChestByNum(num)
  if not e then
    local mem = memory[num]
    if mem then
      e = visitRemembered(num, mem, myToken)
    end
    if cancelled(myToken) then setStatus("Status: stopped") return false end
  end
  if not e then
    setStatus("Status: [" .. num .. "] not found, skipping")
    return false
  end
  if e.part == nil or e.part.Position == nil then
    setStatus("Status: [" .. num .. "] has no position, skipping")
    return false
  end
  if isOpened(e) then
    setStatus("Status: [" .. num .. "] already opened, skipping")
    return true
  end
  memory[num] = e.part.Position
  if cancelled(myToken) then setStatus("Status: stopped") return false end
  local moved = gotoChest(e.part.Position, Flags.Method, myToken)
  if not moved then setStatus("Status: stopped") return false end
  task.wait(0.25)
  if cancelled(myToken) then setStatus("Status: stopped") return false end
  for attempt = 1, Flags.MaxTries do
    if cancelled(myToken) then setStatus("Status: stopped") return false end
    setStatus("Status: [" .. num .. "] opening (try " .. attempt .. "/" .. Flags.MaxTries .. ")...")
    holdPrompt(e.prompt)
    task.wait(0.6)
    if cancelled(myToken) then setStatus("Status: stopped") return false end
    -- re-read opened state: prompt path alone is often enough
    if isOpened(e) then
      if not openedSet[num] then openedSet[num] = true uniqueOpened = uniqueOpened + 1 end
      totalOpens = totalOpens + 1
      updateChestCount()
      setStatus("Status: [" .. num .. "] opened! (" .. uniqueOpened .. " unique)")
      say("Opened chest " .. num)
      return true
    end
    -- prompt alone failed: try the remote fallback once, then check again
    if cancelled(myToken) then setStatus("Status: stopped") return false end
    tryRemoteFallback(e.model, num, attempt)
    task.wait(0.5)
    if cancelled(myToken) then setStatus("Status: stopped") return false end
    -- re-read opened state
    if isOpened(e) then
      if not openedSet[num] then openedSet[num] = true uniqueOpened = uniqueOpened + 1 end
      totalOpens = totalOpens + 1
      updateChestCount()
      setStatus("Status: [" .. num .. "] opened! (" .. uniqueOpened .. " unique)")
      say("Opened chest " .. num)
      return true
    end
    -- prompt may have been replaced; re-resolve once
    if attempt < Flags.MaxTries then
      task.wait(0.3)
      if cancelled(myToken) then setStatus("Status: stopped") return false end
      local fresh = findChestByNum(num)
      if fresh then e = fresh end
    end
  end
  setStatus("Status: [" .. num .. "] did not open after " .. Flags.MaxTries .. " tries, moving on")
  return false
end

-- THE sweep: strict numeric order From -> To. never repeats a chest in one sweep.
local function collectOrdered(myToken)
  ensureCache()
  lastSeen = {}
  local total = Flags.To - Flags.From + 1
  local done = 0
  for num = Flags.From, Flags.To do
    if cancelled(myToken) then setStatus("Status: stopped") return done end
    setStatus("Status: going to chest " .. num .. " (" .. (done + 1) .. "/" .. total .. ")")
    collectOneNum(num, myToken)
    done = done + 1
    if cancelled(myToken) then setStatus("Status: stopped") return done end
    task.wait(Flags.Delay)
    if cancelled(myToken) then setStatus("Status: stopped") return done end
  end
  if cancelled(myToken) then setStatus("Status: stopped") return done end
  local left = 0
  for num = Flags.From, Flags.To do
    local e2 = cache[num]
    if e2 and not isOpened(e2) then left = left + 1 end
  end
  if left == 0 then
    setStatus("Status: sweep done - all chests opened!")
  else
    setStatus("Status: sweep done - " .. left .. " chest(s) still closed, run again")
  end
  return done
end

-- INSTANT BURST: teleport + fire every chest back-to-back with no per-chest
-- verification waits, then ONE short wait and a single verify pass. As close
-- to "all at once" as a distance-checking server allows: movement is still
-- instant CFrame teleports (so proximity checks pass), with a small 0.15s
-- beat per chest so it reads as fast movement rather than a same-frame
-- vacuum (which is what anti-cheat flags). ~10s for all 54.
local function collectInstant(myToken)
  if cancelled(myToken) then setStatus("Status: stopped") return 0 end
  ensureCache()
  local targets = {}
  local skipped = 0
  for num = Flags.From, Flags.To do
    if cancelled(myToken) then setStatus("Status: stopped") return 0 end
    local e = cache[num]
    if not e or e.model.Parent == nil or not e.prompt or e.prompt.Parent == nil then
      e = findChestByNum(num)
    end
    if e and e.part and e.part.Position and not isOpened(e) then
      targets[#targets + 1] = e
    elseif not e then
      skipped = skipped + 1
    end
  end
  if #targets == 0 then
    setStatus("Status: burst done - nothing closed to open" .. (skipped > 0 and " (" .. skipped .. " not found)" or ""))
    say("Instant burst: nothing to open")
    return 0
  end
  setStatus("Status: burst - firing " .. #targets .. " chests...")
  say("Instant burst: firing " .. #targets .. " chests back-to-back")
  for _, e in ipairs(targets) do
    if cancelled(myToken) then setStatus("Status: stopped") return 0 end
    local hrp = chestHRP()
    if hrp then
      pcall(function()
        hrp.CFrame = CFrame.new(e.part.Position.X, e.part.Position.Y + 3, e.part.Position.Z)
      end)
    end
    holdPrompt(e.prompt)
    tryRemoteFallback(e.model, e.num, 1)
    task.wait(0.15)
  end
  if cancelled(myToken) then setStatus("Status: stopped") return 0 end
  task.wait(1.5)
  local opened = 0
  for _, e in ipairs(targets) do
    if cancelled(myToken) then setStatus("Status: stopped") return opened end
    if isOpened(e) then
      if not openedSet[e.num] then openedSet[e.num] = true uniqueOpened = uniqueOpened + 1 end
      totalOpens = totalOpens + 1
      opened = opened + 1
    end
  end
  updateChestCount()
  local left = #targets - opened
  if left == 0 then
    setStatus("Status: burst done - all " .. opened .. " opened!" .. (skipped > 0 and " (" .. skipped .. " not found)" or ""))
  else
    setStatus("Status: burst done - " .. opened .. "/" .. #targets .. " opened, " .. left .. " need the normal sweep")
  end
  say("Instant burst: " .. opened .. "/" .. #targets .. " opened")
  return opened
end

-- legacy nearest-first single pass (kept for the old button).
local function collectNearestOnce(myToken)
  if cancelled(myToken) then setStatus("Status: stopped") return 0 end
  ensureCache()
  local hrp = chestHRP()
  if not hrp then
    setStatus("Status: waiting for character...")
    return 0
  end
  local best = nil
  local bestD = 1e9
  for num = Flags.From, Flags.To do
    local e = findChestByNum(num)
    if e and not isOpened(e) and e.part and e.part.Position then
      local d = dist3(hrp.Position, e.part.Position)
      if d <= Flags.Radius and d < bestD then bestD = d best = e end
    end
  end
  if not best then
    setStatus("Status: 0 chest(s) in range")
    return 0
  end
  if cancelled(myToken) then setStatus("Status: stopped") return 0 end
  setStatus("Status: going to nearest chest " .. best.num)
  collectOneNum(best.num, myToken)
  return 1
end

-- Drop system (ported from the chest-collector module), TURBO cadence:
-- every press is a real GUI click (firesignal/Activate), exactly what an
-- auto-clicker does - and fast clicks were validated safe in-game (no
-- crash, counts stay correct, no freeze). so the dead air is gone:
-- post-click settles 0.4s -> 0.05s, confirm poll 12x0.25s (3s!) ->
-- 30x0.05s (1.5s window, same coverage), rebuild 0.9s -> 0.35s.
-- correctness guards are untouched: recount after every step, 30-try cap,
-- noProgress>=3 stuck guard, remote fallback at most 1 in 3 tries.
-- never throws.
local dropToken = 0

-- any drop loop carrying an old token must stop at its next checkpoint.
-- nil token = no cancellation (demo / one-off calls).
local function cancelledDrop(myToken)
  return myToken ~= nil and myToken ~= dropToken
end

-- Inventory GUI: Drop All opens it for now.
local function getPlayerGui()
  local pg = nil
  pcall(function()
    if LP and LP.FindFirstChild then
      pg = LP:FindFirstChild("PlayerGui")
    end
  end)
  if pg == nil then
    pcall(function()
      if LP then pg = LP.PlayerGui end
    end)
  end
  return pg
end

local clickGui -- forward: defined with the drop helpers below
local findHeldTool -- forward: fetchInventoryData calls it; defined below
local btnUsable -- forward: drop/confirm finders call it; defined below

local function findInventoryGui()
  local pg = getPlayerGui()
  if not pg then return nil end
  -- this game's frame first, then generic matches
  local exact = nil
  pcall(function() exact = pg:FindFirstChild("InventoryFrame", true) end)
  if exact then return exact end
  pcall(function() exact = pg:FindFirstChild("Inventory", true) end)
  if exact then return exact end
  local found = nil
  pcall(function()
    for _, d in ipairs(pg:GetDescendants()) do
      if d.Name and string.find(string.lower(d.Name), "inventory") then
        found = d
        break
      end
    end
  end)
  return found
end

-- cached inventory frame: recursive PlayerGui scans are the biggest lag
-- source in the drop loop (called several times per attempt), so resolve
-- once and reuse for 15s while the frame stays alive (alive check guards
-- stale frames; a snapshot-per-phase design means a reopened frame is
-- picked up on the next phase at the latest).
local invFrameCache = nil
local invFrameCacheAt = 0
local function getInvFrame()
  local f = invFrameCache
  local alive = false
  pcall(function()
    alive = f ~= nil and f.Parent ~= nil
  end)
  if alive and tick() - invFrameCacheAt < 15 then return f end
  f = findInventoryGui()
  invFrameCache = f
  invFrameCacheAt = tick()
  return f
end

local function setGuiOpen(gui, open)
  if not gui then return end
  pcall(function()
    if gui.ClassName == "ScreenGui" then
      gui.Enabled = open
    else
      gui.Visible = open
    end
  end)
  -- ensure parents are visible/enabled up to PlayerGui
  pcall(function()
    local cur = gui.Parent
    while cur and cur.ClassName ~= "PlayerGui" and cur.ClassName ~= "DataModel" do
      if cur.IsA and cur:IsA("GuiObject") then cur.Visible = true end
      if cur.ClassName == "ScreenGui" then cur.Enabled = true end
      cur = cur.Parent
    end
  end)
end

local function isGuiOpen(gui)
  local open = true
  pcall(function()
    if gui.ClassName == "ScreenGui" then
      open = gui.Enabled == true
    elseif gui.Visible ~= nil then
      open = gui.Visible == true
    end
  end)
  return open
end

-- the button players tap to open the bag (used when forcing Visible is not enough)
local function findInventoryToggle()
  local pg = getPlayerGui()
  if not pg then return nil end
  local all = nil
  pcall(function() all = pg:GetDescendants() end)
  if not all then return nil end
  for _, d in ipairs(all) do
    if d.ClassName == "TextButton" or d.ClassName == "ImageButton" then
      local vis = true
      pcall(function() vis = d.Visible ~= false end)
      if vis then
        local hit = false
        pcall(function()
          local n = string.lower(d.Name or "")
          if string.find(n, "invent") or string.find(n, "bag") or string.find(n, "backpack") then hit = true end
        end)
        if not hit then
          pcall(function()
            local t = string.lower(d.Text or "")
            if string.find(t, "invent") or string.find(t, "bag") or string.find(t, "backpack") then hit = true end
          end)
        end
        if hit then return d end
      end
    end
  end
  return nil
end

local function openInventory()
  local gui = getInvFrame()
  if not gui then
    setStatus("Status: inventory GUI not found")
    say("Inventory GUI not found (looked for 'InventoryFrame' in PlayerGui)")
    return false
  end
  setGuiOpen(gui, true)
  task.wait(0.05)
  if isGuiOpen(gui) then
    setStatus("Status: inventory open")
    say("Inventory opened")
    return true
  end
  -- game keeps it shut: tap its own toggle button like a player would.
  local toggle = findInventoryToggle()
  if toggle then
    clickGui(toggle)
    task.wait(0.1)
    if isGuiOpen(gui) then
      setStatus("Status: inventory open")
      say("Inventory opened")
      return true
    end
  end
  -- last resort: one toggle tap can force the game to build/populate the
  -- item list even when Visible=true already reads "open" but no slots
  -- respond (the old silent "does nothing" case). never throws.
  if toggle then
    clickGui(toggle)
    task.wait(0.15)
    setGuiOpen(gui, true)
    task.wait(0.1)
  end
  setStatus("Status: inventory may still be closed - continuing anyway")
  say("Inventory would not stay closed - continuing anyway")
  return true
end

-- forces the game to rebuild its item list: close, reopen, recount.
-- the client GUI often keeps showing dropped items (ghosts) even though the
-- server already removed them - without this both the player AND the script
-- recount believe items that are already gone.
-- forces the game to rebuild its item list: CLOSE the bag, then REOPEN it,
-- through the game's OWN toggle button so its open/close scripts actually
-- run and the list updates. just flipping Visible does not run the game's
-- logic - the bag looks open but the counts stay frozen on ghosts, which
-- is why the recount kept seeing already-dropped items. falls back to the
-- Visible flip when no toggle button exists (mock demo). never throws.
-- returns the re-fetched frame or nil.
local function refreshInventory()
  local toggle = findInventoryToggle()
  if toggle ~= nil then
    local gui = getInvFrame()
    if gui == nil or isGuiOpen(gui) then
      clickGui(toggle) -- close
      task.wait(0.2)
    end
    invFrameCache = nil -- the game may destroy + rebuild the frame: rescan
    gui = getInvFrame()
    if gui == nil then
      clickGui(toggle) -- closed state destroys the frame: tap again to open
      task.wait(0.25)
      invFrameCache = nil
      gui = getInvFrame()
    end
    if gui ~= nil and not isGuiOpen(gui) then
      clickGui(toggle) -- open
      task.wait(0.25)
      invFrameCache = nil
      gui = getInvFrame()
    end
    if gui ~= nil and not isGuiOpen(gui) then
      setGuiOpen(gui, true)
      task.wait(0.15)
    end
    return getInvFrame()
  end
  local gui = getInvFrame()
  if not gui then return nil end
  setGuiOpen(gui, false)
  task.wait(0.15)
  invFrameCache = nil
  gui = getInvFrame()
  if gui == nil then return nil end
  setGuiOpen(gui, true)
  task.wait(0.2)
  return gui
end

-- Drop spot: while auto drop runs, the player is frozen here, standing upright.
-- (Pitching the root part lays the whole rig flat, which left the character
-- positioned wrong - so the character stands and the camera looks down instead.)
local DropSpotX, DropSpotY, DropSpotZ = 298, 17, 207

local function zeroMotion(hrp)
  pcall(function()
    hrp.Velocity = Vector3.zero
    hrp.RotVelocity = Vector3.zero
  end)
  pcall(function()
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
  end)
end

local function dropSpotCFrame()
  return CFrame.new(DropSpotX, DropSpotY, DropSpotZ)
end

-- seconds between forced re-pins during a sustained drift. Pin once, then
-- hold the anchor: machine-gun teleporting against a server pull is what
-- gets players kicked (looks like a crash after a while).
local lastPinTime = 0

-- full freeze, skipped when already placed+anchored: unanchor FIRST (a CFrame
-- set on an already-anchored part does not always replicate, so the server
-- snaps the character back), kill all velocity, double-set the standing
-- CFrame, then anchor. camera looks down at the drop pile.
local function freezeAtDropSpot()
  local hrp = chestHRP()
  if not hrp then return nil end
  local placed = false
  pcall(function()
    local p = hrp.Position
    local dx = p.X - DropSpotX
    local dy = p.Y - DropSpotY
    local dz = p.Z - DropSpotZ
    placed = math.sqrt(dx * dx + dy * dy + dz * dz) < 3 and hrp.Anchored == true
  end)
  if placed then
    lastPinTime = tick()
    return hrp
  end
  pcall(function() hrp.Anchored = false end)
  zeroMotion(hrp)
  pcall(function() hrp.CFrame = dropSpotCFrame() end)
  task.wait(0.05)
  pcall(function() hrp.CFrame = dropSpotCFrame() end)
  zeroMotion(hrp)
  pcall(function() hrp.Anchored = true end)
  lastPinTime = tick()
  pcall(function()
    local cam = workspace.CurrentCamera
    if cam then
      cam.CFrame = CFrame.new(
        Vector3.new(DropSpotX, DropSpotY + 14, DropSpotZ + 4),
        Vector3.new(DropSpotX, DropSpotY, DropSpotZ))
    end
  end)
  return hrp
end

-- light maintenance between drops: only re-teleport when drifted more than
-- 2.5 studs (no more constant teleport spam), always hold the anchor.
local function holdDropSpot()
  pcall(function()
    local hrp = chestHRP()
    if not hrp then return end
    local drifted = true
    pcall(function()
      local p = hrp.Position
      local dx = p.X - DropSpotX
      local dy = p.Y - DropSpotY
      local dz = p.Z - DropSpotZ
      drifted = math.sqrt(dx * dx + dy * dy + dz * dz) > 2.5
    end)
    if drifted then
      local now = tick()
      if now - lastPinTime > 3 then
        lastPinTime = now
        zeroMotion(hrp)
        hrp.CFrame = dropSpotCFrame()
      end
    end
    hrp.Anchored = true
  end)
end

local function unfreezeNow()
  pcall(function()
    local hrp = chestHRP()
    if hrp then hrp.Anchored = false end
  end)
end

-- Drop All: priority order, click each item then drop until its count is 0.
local DropOrder = {"Legendary Arrow", "Shiny Arrow", "Stand Arrow", "Locacaca Fruit"}

-- clicks a GuiButton the way a real click does: fire EVERY signal the game
-- could listen on (down + click + activated + connections + Activate).
-- turbo-safe: this is exactly what an auto-clicker does, and rapid real
-- clicks were validated in-game (no crash, counts stay correct).
-- never throws. returns true if anything was attempted.
clickGui = function(btn)
  if btn == nil then return false end
  local clicked = false
  pcall(function()
    if typeof(firesignal) == "function" and btn.MouseButton1Down then
      firesignal(btn.MouseButton1Down)
      clicked = true
    end
  end)
  pcall(function()
    if typeof(firesignal) == "function" and btn.MouseButton1Click then
      firesignal(btn.MouseButton1Click)
      clicked = true
    end
  end)
  -- connections: Activated + Click only (the signals a real click ends
  -- with). the old code also fired every MouseButton1Down connection - a
  -- lone Down without Up is meaningless input-wise, and double-ran any
  -- handler listening on both Down and Click/Activated.
  pcall(function()
    if typeof(getconnections) == "function" then
      for _, sigName in ipairs({"MouseButton1Click", "Activated"}) do
        local sig = btn[sigName]
        if sig then
          for _, c in ipairs(getconnections(sig)) do
            pcall(function() c:Fire() end)
            clicked = true
          end
        end
      end
    end
  end)
  pcall(function()
    if btn.Activate then
      btn:Activate()
      clicked = true
    end
  end)
  pcall(function()
    if typeof(firesignal) == "function" and btn.Activated then
      firesignal(btn.Activated)
      clicked = true
    end
  end)
  return clicked
end

local function parseSlotCount(slot)
  local count = 1
  local foundNumber = false
  local function scanText(t)
    if type(t) ~= "string" then return end
    local m = string.match(t, "[xX]%s*(%d+)")
    if m then
      count = tonumber(m)
      foundNumber = true
      return
    end
    local m2 = string.match(t, "%((%d+)%)")
    if m2 then
      count = tonumber(m2)
      foundNumber = true
      return
    end
    local m3 = string.match(t, "^%s*(%d+)%s*$")
    if m3 and not foundNumber then
      count = tonumber(m3)
      foundNumber = true
    end
  end
  pcall(function() scanText(slot.Text) end)
  -- direct children only: counts live in a child label next to the slot.
  -- the old code walked the whole subtree per slot (O(n*m)), which froze
  -- big inventories - one shallow pass finds the same "x2" text.
  pcall(function()
    for _, d in ipairs(slot:GetChildren()) do
      if d.ClassName == "TextLabel" or d.ClassName == "TextButton" then
        local t = nil
        pcall(function() t = d.Text end)
        scanText(t)
        if foundNumber then break end
      end
    end
  end)
  return count
end

-- normalized compare so "Legendary_Arrow", "legendary arrow " etc still match
local function normItemName(s)
  s = string.lower(s or "")
  s = string.gsub(s, "[^%a%d]", "")
  return s
end

-- returns slot gui + count for an item inside one container (frame scope).
-- the matcher from the working build: exact own-text on clickables first,
-- then frames, then child labels, then one-direction fuzzy for decorated
-- names ("Legendary Arrow ★"). clickables win so a list frame never
-- shadows the slot button inside it.
local function findItemSlotIn(container, itemName, preAll)
  if not container then return nil end
  local want = normItemName(itemName)
  if want == "" then return nil end
  local all = preAll
  if not all then
    pcall(function() all = container:GetDescendants() end)
  end
  if not all then return nil end
  local function isSlotClass(d)
    local cls = d.ClassName
    return cls == "TextButton" or cls == "ImageButton" or cls == "Frame" or cls == "ImageLabel" or cls == "TextLabel"
  end
  local function ownNorms(d)
    local out = {}
    pcall(function() if d.Name then out[#out + 1] = normItemName(d.Name) end end)
    pcall(function() if d.Text then out[#out + 1] = normItemName(d.Text) end end)
    return out
  end
  local function childLabelNorms(d)
    local out = {}
    -- direct children only (was GetDescendants per candidate: O(n*m) and
    -- the main freeze source). slot name labels sit one level down.
    pcall(function()
      for _, c in ipairs(d:GetChildren()) do
        if c.ClassName == "TextLabel" or c.ClassName == "TextButton" then
          local t = nil
          pcall(function() t = c.Text end)
          if t then out[#out + 1] = normItemName(t) end
        end
      end
    end)
    return out
  end
  local cands = {}
  for _, d in ipairs(all) do
    if isSlotClass(d) then cands[#cands + 1] = d end
  end
  local function isClickable(d)
    return d.ClassName == "TextButton" or d.ClassName == "ImageButton"
  end
  -- pass 1a: exact own-text on clickables
  for _, d in ipairs(cands) do
    if isClickable(d) then
      for _, t in ipairs(ownNorms(d)) do
        if t ~= "" and t == want then return d, parseSlotCount(d) end
      end
    end
  end
  -- pass 1b: exact own-text on frames (TextLabels skipped: a nested label
  -- match must resolve to its slot frame in 1c, clicking the bare label
  -- does nothing)
  for _, d in ipairs(cands) do
    if not isClickable(d) and d.ClassName ~= "TextLabel" then
      for _, t in ipairs(ownNorms(d)) do
        if t ~= "" and t == want then return d, parseSlotCount(d) end
      end
    end
  end
  -- pass 1c: exact child-label text (slot frame named "Slot1")
  for _, d in ipairs(cands) do
    for _, t in ipairs(childLabelNorms(d)) do
      if t ~= "" and t == want then return d, parseSlotCount(d) end
    end
  end
  -- pass 2: fuzzy (decorated names) - haystack must CONTAIN the full wanted
  -- name; never the reverse, so a bare "Arrow" label can never shadow a
  -- real "Shiny Arrow" slot.
  if #want >= 4 then
    for _, d in ipairs(cands) do
      if isClickable(d) then
        for _, t in ipairs(ownNorms(d)) do
          if t ~= "" and string.find(t, want, 1, true) then return d, parseSlotCount(d) end
        end
      end
    end
    for _, d in ipairs(cands) do
      if not isClickable(d) and d.ClassName ~= "TextLabel" then
        for _, t in ipairs(ownNorms(d)) do
          if t ~= "" and string.find(t, want, 1, true) then return d, parseSlotCount(d) end
        end
      end
    end
    for _, d in ipairs(cands) do
      for _, t in ipairs(childLabelNorms(d)) do
        if t ~= "" and string.find(t, want, 1, true) then return d, parseSlotCount(d) end
      end
    end
  end
  return nil
end

-- frame first ("fetch" scope). when the frame exists the search stays
-- inside it: the old whole-PlayerGui fallback re-scanned thousands of
-- unrelated nodes on every miss and froze the game. full PlayerGui is
-- only searched when there is no frame at all.
local function findItemSlot(itemName)
  local frame = getInvFrame()
  if frame then
    return findItemSlotIn(frame, itemName)
  end
  local pg = getPlayerGui()
  if pg then
    return findItemSlotIn(pg, itemName)
  end
  return nil
end

-- one scan, all targets: snapshot the frame once per attempt and derive
-- the slot + drop + confirm buttons from the same list instead of
-- re-walking PlayerGui 6-8 times per attempt.
local function snapshotFrame()
  local frame = getInvFrame()
  if not frame then return nil, nil end
  local all = nil
  pcall(function() all = frame:GetDescendants() end)
  return frame, all
end

-- reads the frame's item entries ("fetch data"): logs every DropOrder item
-- with its count, returns the ones actually present.
local function fetchInventoryData()
  local data = {}
  local frame = getInvFrame()
  if not frame then
    say("Fetch: no InventoryFrame found")
    return data
  end
  local n = 0
  -- one snapshot reused for the count AND all four items (was 5 scans).
  local snap = nil
  pcall(function()
    if frame then snap = frame:GetDescendants() end
    if snap then n = #snap end
  end)
  say("Fetch: '" .. tostring(frame.Name) .. "' has " .. n .. " descendants")
  for _, itemName in ipairs(DropOrder) do
    local fs, fc = findItemSlotIn(frame, itemName, snap)
    local tool = findHeldTool(itemName)
    if fs then
      data[#data + 1] = { slot = fs, name = itemName, count = fc or 1 }
      say("Fetch: " .. itemName .. " x" .. (fc or 1) .. " (slot)"
        .. (tool and " + held" or ""))
    elseif tool then
      data[#data + 1] = { slot = tool, name = itemName, count = 1 }
      say("Fetch: " .. itemName .. " x1 (held, no slot)")
    else
      say("Fetch: " .. itemName .. " x0")
    end
  end
  return data
end

-- finds a tool by name in Backpack AND Character (equipping moves it to
-- Character - only checking Backpack reported "dropped" while still held).
findHeldTool = function(itemName)
  local want = string.lower(itemName)
  local found = nil
  local function searchContainer(cont)
    if not cont or found then return end
    pcall(function()
      for _, c in ipairs(cont:GetChildren()) do
        if c.Name and string.lower(c.Name) == want then
          found = c
          break
        end
      end
    end)
  end
  local pack = nil
  pcall(function()
    if LP and LP.FindFirstChild then pack = LP:FindFirstChild("Backpack") end
  end)
  if not pack then
    pcall(function() if LP then pack = LP.Backpack end end)
  end
  searchContainer(pack)
  local char = nil
  pcall(function() if LP then char = LP.Character end end)
  searchContainer(char)
  return found
end

-- Drop-button search from the working build: inventory subtree first (a
-- stray global "Drop" from another menu shadowed the real one), usability
-- filtered, plain substring fallback.
local function buttonMatches(d, words)
  local hit = false
  pcall(function()
    local n = string.lower(d.Name or "")
    for _, w in ipairs(words) do
      if string.find(n, w, 1, true) then hit = true break end
    end
  end)
  if not hit then
    pcall(function()
      local t = string.lower(d.Text or "")
      for _, w in ipairs(words) do
        if string.find(t, w, 1, true) then hit = true break end
      end
    end)
  end
  return hit
end

local function findDropButtonIn(container, exceptBtn, preAll)
