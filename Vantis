-- pin the character mid-air. anchoring the HRP is what stops the fall
-- between teleports; velocities are zeroed so there is no drift.
-- never throws. call with false to hand physics back (Land button,
-- farm toggle off). the loop re-anchors on every teleport, so a
-- respawned character gets pinned again on the next pass.
local function setFloat(on)
  local hrp = getPlayerHRP()
  if hrp then
    pcall(function() hrp.Anchored = on end)
    pcall(function() hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
    pcall(function() hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0) end)
    pcall(function() hrp.Velocity = Vector3.new(0, 0, 0) end)
    pcall(function() hrp.RotVelocity = Vector3.new(0, 0, 0) end)
  end
  local hum = getHumanoid()
  if hum then
    pcall(function() hum.PlatformStand = on end)
  end
end

-- float position pose for the farm pin. Above = overhead looking down,
-- Behind = 3 studs behind the NPC (its facing, world +Z fallback) at
-- hover height facing it, Below = underneath looking up. mock-safe
-- (no CFrame*Vector3, yaw via two-arg atan).
local function modeLabel()
  if floatPos == "Behind" then return "3 studs behind" end
  if floatPos == "Below" then return "below" end
  return "above"
end

local function hoverPose(rp)
  local h = Flags.NpcHeight or 5
  if floatPos == "Behind" then
    local lx, lz = 0, 1
    pcall(function()
      local lv = rp.CFrame.LookVector
      if lv ~= nil and lv.X ~= nil then lx, lz = lv.X, lv.Z end
    end)
    local len = math.sqrt(lx * lx + lz * lz)
    if len > 0.001 then lx, lz = lx / len, lz / len end
    local px = rp.Position.X - lx * 3
    local pz = rp.Position.Z - lz * 3
    local yaw = 0
    pcall(function()
      yaw = math.atan(-(rp.Position.X - px), -(rp.Position.Z - pz))
    end)
    return CFrame.new(px, rp.Position.Y + h, pz) * CFrame.Angles(0, yaw, 0)
  end
  if floatPos == "Below" then
    return CFrame.new(rp.Position.X, rp.Position.Y - h, rp.Position.Z)
      * CFrame.Angles(math.rad(90), 0, 0)
  end
  return CFrame.new(rp.Position.X, rp.Position.Y + h, rp.Position.Z)
    * CFrame.Angles(math.rad(-90), 0, 0)
end

-- teleports the player to the current float pose + pins. returns false
-- when there is nothing to pin to. never throws.
local function pinTo(rp)
  local hrp = getPlayerHRP()
  if hrp == nil or rp == nil or rp.Position == nil then return false end
  pcall(function() hrp.CFrame = hoverPose(rp) end)
  setFloat(true)
  return true
end

-- mobile-to-PC skill map (from the phone HUD: Punch / Secondary buttons
-- plus the Ability 1-6 circles and the 1-6 hotbar underneath them).
local MOBILE_BUTTON = {
  M1 = "Punch", M2 = "Secondary",
  E = "Ability 1", R = "Ability 2", G = "Ability 3",
  C = "Ability 4", X = "Ability 5", V = "Ability 6",
}
local mobileBtnCache = {}
local touchReported = false

local function normBtn(s)
  s = string.lower(s or "")
  return (string.gsub(s, "[^%a%d]", ""))
end

local function isBtn(d)
  local ok, res = pcall(function()
    return d:IsA("TextButton") or d:IsA("ImageButton")
  end)
  return ok and res
end

-- finds the touch button for a skill, cached, rescans when the HUD rebuilds.
-- returns nil on PC (no touch buttons) so callers fall back to keys.
local function findMobileButton(skillKey)
  local want = MOBILE_BUTTON[skillKey]
  if want == nil then return nil end
  local cached = mobileBtnCache[skillKey]
  if cached ~= nil then
    local alive = false
    pcall(function() alive = cached.Parent ~= nil end)
    if alive then return cached end
    mobileBtnCache[skillKey] = nil
  end
  local pg = nil
  pcall(function()
    if LP.FindFirstChildOfClass then pg = LP:FindFirstChildOfClass("PlayerGui") end
  end)
  if pg == nil then
    pcall(function() pg = LP:FindFirstChild("PlayerGui") end)
  end
  if pg == nil then return nil end
  local desc = nil
  pcall(function() desc = pg:GetDescendants() end)
  if desc == nil then return nil end
  local wantNorm = normBtn(want)
  local fallback = nil
  for _, d in ipairs(desc) do
    if isBtn(d) then
      local name = ""
      pcall(function() name = normBtn(d.Name) end)
      local text = ""
      pcall(function() text = normBtn(d.Text) end)
      local vis = true
      pcall(function() vis = d.Visible end)
      if vis and (name == wantNorm or text == wantNorm) then
        -- exact ability hits win over bare-number hotbar text ("1")
        if name:find("ability", 1, true) then
          mobileBtnCache[skillKey] = d
          if not touchReported then
            touchReported = true
            say("Touch controls found - tapping on-screen buttons")
          end
          return d
        elseif fallback == nil then
          fallback = d
        end
      end
    end
  end
  if fallback ~= nil then
    mobileBtnCache[skillKey] = fallback
    if not touchReported then
      touchReported = true
      say("Touch controls found - tapping on-screen buttons")
    end
  end
  return fallback
end

-- taps (or holds) a touch button: firesignal when the executor has it,
-- else a VirtualUser tap at the button's screen center. returns true if
-- anything was sent. never throws.
local function tapButton(btn, holdSecs)
  local vu = nil
  pcall(function() vu = game:GetService("VirtualUser") end)
  local center = nil
  pcall(function()
    local p = btn.AbsolutePosition
    local s = btn.AbsoluteSize
    center = Vector2.new(p.X + s.X / 2, p.Y + s.Y / 2)
  end)
  local cam = nil
  pcall(function() cam = workspace.CurrentCamera end)
  if holdSecs ~= nil and holdSecs > 0 then
    local held = false
    pcall(function()
      if firesignal then
        if center then
          firesignal(btn.MouseButton1Down, center.X, center.Y)
        else
          firesignal(btn.MouseButton1Down)
        end
        held = true
      end
    end)
    if held then
      task.wait(holdSecs)
      pcall(function()
        if center then
          firesignal(btn.MouseButton1Up, center.X, center.Y)
        else
          firesignal(btn.MouseButton1Up)
        end
      end)
      return true
    end
    if vu ~= nil and center ~= nil then
      local down = pcall(function()
        if cam then vu:Button1Down(center, cam) else vu:Button1Down(center) end
      end)
      if down then
        task.wait(holdSecs)
        pcall(function()
          if cam then vu:Button1Up(center, cam) else vu:Button1Up(center) end
        end)
        return true
      end
    end
    return false
  end
  local sigged = false
  pcall(function()
    if firesignal then firesignal(btn.Activated) sigged = true end
  end)
  if sigged then return true end
  if vu ~= nil and center ~= nil then
    local tapped = pcall(function()
      if cam then vu:ClickButton1(center, cam) else vu:ClickButton1(center) end
    end)
    if tapped then return true end
  end
  return false
end

-- one-shot input status line so a real executor tells the truth: if the
-- executor blocks VirtualInputManager, key/mouse presses can never land
-- and the log says so instead of silently doing nothing.
local inputReported = false
local function reportInput(vim)
  if inputReported then return end
  inputReported = true
  if vim then
    say("Input: VirtualInputManager ready")
  else
    say("Input: no VirtualInputManager (mock has no input - in game this means the executor blocked it)")
  end
  pcall(function()
    if mouse1click then say("Input: mouse1click fallback available") end
  end)
end

-- shared input primitives (rotation + combo both use these).
local cachedVim = "none"
local function getVim()
  if cachedVim == "none" then
    cachedVim = nil
    pcall(function() cachedVim = game:GetService("VirtualInputManager") end)
    reportInput(cachedVim)
  end
  return cachedVim
end

local function vimClick()
  local vim = getVim()
  if vim then
    local ok = pcall(function()
      vim:SendMouseButtonEvent(500, 500, 0, true, game, 0)
      task.wait(0.1)
      vim:SendMouseButtonEvent(500, 500, 0, false, game, 0)
    end)
    if ok then return end
  end
  pcall(function()
    if mouse1click then
      mouse1click()
    elseif mouse1press and mouse1release then
      mouse1press()
      task.wait(0.1)
      mouse1release()
    end
  end)
end

-- M2 / Secondary is a DOUBLE right click in-game (wiki Basics page).
local function vimRightClick()
  local vim = getVim()
  if vim then
    pcall(function()
      for _ = 1, 2 do
        vim:SendMouseButtonEvent(500, 500, 1, true, game, 0)
        task.wait(0.1)
        vim:SendMouseButtonEvent(500, 500, 1, false, game, 0)
        task.wait(0.15)
      end
    end)
  end
end

local function keyDown(code)
  local vim = getVim()
  if vim then
    local ok = pcall(function() vim:SendKeyEvent(true, code, false, game) end)
    if ok then return true end
  end
  local keyVal = code
  pcall(function() if code.Value ~= nil then keyVal = code.Value end end)
  local pressed = false
  pcall(function()
    if keypress then keypress(keyVal) pressed = true end
  end)
  return pressed
end

local function keyUp(code)
  local vim = getVim()
  if vim then
    pcall(function() vim:SendKeyEvent(false, code, false, game) end)
    return
  end
  local keyVal = code
  pcall(function() if code.Value ~= nil then keyVal = code.Value end end)
  pcall(function()
    if keyrelease then keyrelease(keyVal) end
  end)
end

local TAP_KEYS = { R = Enum.KeyCode.R, G = Enum.KeyCode.G,
  C = Enum.KeyCode.C, X = Enum.KeyCode.X, V = Enum.KeyCode.V }

local function tapPc(skillKey)
  if skillKey == "M1" then
    vimClick()
  elseif skillKey == "M2" then
    vimRightClick()
  else
    local code = TAP_KEYS[skillKey]
    if code ~= nil then
      keyDown(code)
      task.wait(0.15)
      keyUp(code)
    end
  end
end

-- single tap through touch buttons (mobile) or keys (PC). honors the
-- Farm multi-select. Common-stand toggle skips V. never throws.
local function doTapSkill(skillKey)
  if not Flags.Skills[skillKey] then return end
  if skillKey == "V" and Flags.NoV then
    say("Skill: V skipped (Common stand)")
    return
  end
  local btn = findMobileButton(skillKey)
  if btn ~= nil then
    if tapButton(btn) then
      say("Skill: " .. skillKey .. " (touch)")
      return
    end
    say("Skill: " .. skillKey .. " (touch blocked, trying keys)")
  elseif touchReported then
    say("Skill: " .. skillKey .. " (no touch button mapped)")
  end
  tapPc(skillKey)
  say("Skill: " .. skillKey)
end

-- E hold 3s through touch (Ability 1) or key. honors multi-select.
local function fireEHold()
  if not Flags.Skills.E then return end
  local btn = findMobileButton("E")
  if btn ~= nil then
    if tapButton(btn, 3) then
      say("Skill: E hold (3s, touch)")
    else
      say("Skill: E hold (touch blocked, trying key)")
      keyDown(Enum.KeyCode.E)
      task.wait(3)
      keyUp(Enum.KeyCode.E)
      say("Skill: E hold (3s)")
    end
  else
    keyDown(Enum.KeyCode.E)
    say("Skill: E hold (3s)...")
    task.wait(3)
    keyUp(Enum.KeyCode.E)
  end
end

-- visible-but-transparent overlays are not real cooldowns.
local function overlayShowing(d)
  local vis = true
  pcall(function() vis = d.Visible end)
  if not vis then return false end
  local seen, opaque = false, false
  pcall(function()
    local t = d.BackgroundTransparency
    if type(t) == "number" then
      seen = true
      if t < 0.99 then opaque = true end
    end
  end)
  pcall(function()
    local t = d.ImageTransparency
    if type(t) == "number" then
      seen = true
      if t < 0.99 then opaque = true end
    end
  end)
  pcall(function()
    local t = d.TextTransparency
    if type(t) == "number" then
      seen = true
      if t < 0.99 then opaque = true end
    end
  end)
  if not seen then return true end
  return opaque
end

-- true when the skill's button shows a cooldown (named overlay, or a
-- numbered countdown label). static hotbar key numbers are ignored:
-- only cooldown/timer-ish names count. never throws.
local function onCooldown(skillKey)
  local btn = findMobileButton(skillKey)
  if btn == nil then return false end
  local cooling = false
  pcall(function()
    for _, d in ipairs(btn:GetDescendants()) do
      local nm = ""
      pcall(function() nm = string.lower(d.Name or "") end)
      if nm:find("cooldown", 1, true) then
        if overlayShowing(d) then
          local txt = nil
          pcall(function() txt = d.Text end)
          local num = tonumber(txt or "")
          if num == nil or num > 0 then cooling = true end
        end
      elseif nm:find("timer", 1, true) or nm:find("remaining", 1, true) or nm:find("counter", 1, true) or nm == "cd" then
        local txt = nil
        pcall(function() txt = d.Text end)
        local num = tonumber(txt or "")
        if num ~= nil and num > 0 then
          if overlayShowing(d) then cooling = true end
        end
      end
      if cooling then break end
    end
  end)
  return cooling
end

-- combo gate: multi-select off or Common-stand V = silent skip,
-- cooling = skip + log.
local function comboReady(skillKey)
  if not Flags.Skills[skillKey] then return false end
  if skillKey == "V" and Flags.NoV then return false end
  if onCooldown(skillKey) then
    say("Combo: " .. skillKey .. " on cooldown, skipping")
    return false
  end
  return true
end

-- Auto Combo: 3x M1, E hold, 3x M1, R, G (or V), C, X.
-- cooling skills skip, the rest of the combo keeps going.
local function runCombo()
  say("Combo: 3x M1, E hold, 3x M1, R, G/V, C, X (cooling skips)")
  for i = 1, 3 do
    if comboReady("M1") then doTapSkill("M1") end
    task.wait(0.25)
  end
  if comboReady("E") then fireEHold() end
  task.wait(0.3)
  for i = 1, 3 do
    if comboReady("M1") then doTapSkill("M1") end
    task.wait(0.25)
  end
  if comboReady("R") then doTapSkill("R") end
  task.wait(0.2)
  if comboReady("G") then
    doTapSkill("G")
  else
    local vFire = Flags.Skills.V and not onCooldown("V")
    if vFire then
      if Flags.Skills.G then say("Combo: G on cooldown, using V instead") end
      doTapSkill("V")
    elseif Flags.Skills.V then
      say("Combo: V on cooldown, skipping")
    end
  end
  task.wait(0.2)
  if comboReady("C") then doTapSkill("C") end
  task.wait(0.2)
  if comboReady("X") then doTapSkill("X") end
  say("Combo: done")
end

-- skill rotation after each teleport. only fires skills enabled in
-- Flags.Skills (Farm tab multi-select). on mobile each skill taps its
-- on-screen button (Punch / Secondary / Ability N, E holds Ability 1);
-- on PC it fires through VirtualInputManager with mouse1click /
-- keypress fallbacks. the editor mock has no input service, so it
-- just logs the rotation. never throws.
local function useSkills()
  local any = false
  for _, k in ipairs(SKILL_LIST) do
    if Flags.Skills[k] then any = true break end
  end
  if not any then
    say("Skills: none selected, skipping rotation")
    return
  end
  getVim() -- warms input + prints the one-shot status line
  doTapSkill("M1")
  doTapSkill("M2")
  fireEHold()
  for _, key in ipairs({"R", "G", "C", "X", "V"}) do
    doTapSkill(key)
  end
end

-- rotation entry: combo when the toggle is on, plain rotation otherwise.
local function fireRotation()
  if Flags.Combo then
    runCombo()
  else
    useSkills()
  end
end

-- increments whenever follow mode must stop (toggle off, Land, new lock).
local followToken = 0

-- background pin loop: re-teleports above the same NPC root every 0.1s
-- so a walking NPC can't leave you behind. stops when the token dies.
local function keepPin(name, myToken, getRp)
  task.spawn(function()
    while Flags.NpcFarm and npcTarget == name and followToken == myToken do
      pinTo(getRp())
      task.wait(0.1)
    end
  end)
end

-- bosses respawn every 1-3 min, mobs every 15-30s: wait longer on a
-- missing boss so the loop doesn't spam rescans. never throws.
local function respawnWait(name)
  local info = NPC_INFO[name]
  if info ~= nil and info.boss then return 5 end
  return 1.5
end

-- single-target mode: lock one NPC, glue above it, spam the rotation
-- until it dies/leaves, the target changes, or the toggle goes off.
local function followTarget(name)
  local npc = findNpcByName(name)
  if npc == nil then
    setStatus("Status: " .. name .. " not found")
    say("NPC farm: " .. name .. " not found, waiting for spawn...")
    return 0
  end
  followToken = followToken + 1
  local myToken = followToken
  say("Locked onto " .. name .. " - following + skill spam (toggle off or Land to stop)")
  setStatus("Status: locked " .. name)
  keepPin(name, myToken, function()
    if npc == nil then return nil end
    return rootPartOf(npc)
  end)
  local cycles = 0
  while Flags.NpcFarm and npcTarget == name and followToken == myToken do
    if npc == nil or not isAlive(npc) then
      say("NPC farm: " .. name .. " down or gone - rescanning...")
      npc = findNpcByName(name)
      if npc == nil then
        task.wait(respawnWait(name))
        if Flags.NpcFarm and npcTarget == name then
          npc = findNpcByName(name)
        end
        if npc == nil then break end
      end
    else
      cycles = cycles + 1
      fireRotation()
      task.wait(0.3)
    end
  end
  if farmCount then
    pcall(function() farmCount:Set("NPCs: " .. (cycles > 0 and 1 or 0)) end)
  end
  say("Unlocked " .. name .. " (" .. cycles .. " rotations)")
  return cycles > 0 and 1 or 0
end

-- one teleport + one rotation, no loop (Go button / single sweep hit).
local function visitOnce(name)
  local hrp = getPlayerHRP()
  if hrp == nil then
    setStatus("Status: waiting for character...")
    say("NPC farm: no character yet")
    return 0
  end
  local npc = findNpcByName(name)
  if npc == nil then
    say("NPC farm: " .. name .. " not found, skipping")
    return 0
  end
  if not isAlive(npc) then
    say("NPC farm: " .. name .. " down, skipping")
    return 0
  end
  local rp = rootPartOf(npc)
  if rp == nil or rp.Position == nil then
    say("NPC farm: " .. name .. " has no position, skipping")
    return 0
  end
  pinTo(rp)
  task.wait(0.25)
  setStatus("Status: " .. modeLabel() .. " " .. name)
  say("Hovering " .. modeLabel() .. " " .. name .. " (pinned)")
  fireRotation()
  task.wait(0.5)
  return 1
end

-- one pass over the current NPC target. returns npcs visited.
local function farmNpcsOnce()
  local hrp = getPlayerHRP()
  if hrp == nil then
    setStatus("Status: waiting for character...")
    say("NPC farm: no character yet")
    return 0
  end
  -- single target: lock + follow while the toggle is on, one visit for Go.
  if npcTarget ~= "All" then
    if Flags.NpcFarm then
      return followTarget(npcTarget)
    end
    return visitOnce(npcTarget)
  end
  local targets = {}
  if npcTarget == "All" then
    for _, n in ipairs(NPC_LIST) do targets[#targets + 1] = n end
  else
    targets[1] = npcTarget
  end
  local visited = 0
  for _, name in ipairs(targets) do
    local npc = findNpcByName(name)
    if npc == nil then
      say("NPC farm: " .. name .. " not found, skipping")
    elseif not isAlive(npc) then
      say("NPC farm: " .. name .. " down, skipping")
    else
      local rp = rootPartOf(npc)
      if rp and rp.Position then
        -- hover at the chosen float pose, pinned so there is no falling
        -- between teleports.
        pinTo(rp)
        task.wait(0.25)
        visited = visited + 1
        setStatus("Status: " .. modeLabel() .. " " .. name .. " (" .. visited .. ")")
        say("Hovering " .. modeLabel() .. " " .. name .. " (pinned)")
        fireRotation()
        task.wait(0.5)
      end
    end
  end
  if visited == 0 then
    setStatus("Status: no NPCs found")
  else
    setStatus("Status: hovering (" .. visited .. " npc)")
  end
  if farmCount then
    pcall(function() farmCount:Set("NPCs: " .. visited) end)
  end
  say("NPCs: " .. visited)
  return visited
end

-- VantixUI load (real) or fallback shim (editor mock)
local VantixUI = nil
do
  local ok, lib = pcall(function()
    local src = game:HttpGet("https://raw.githubusercontent.com/Snipez-Dev/Vantix/refs/heads/main/VantixUI6")
    return loadstring(src)()
  end)
  if ok and type(lib) == "table" and type(lib.CreateWindow) == "function" then
    VantixUI = lib
  end
end
local FALLBACK = (VantixUI == nil)

if FALLBACK then
  local function newSignal()
    local sig = { _cons = {} }
    function sig:Connect(fn)
      table.insert(sig._cons, fn)
      return { Connected = true, Disconnect = function() end }
    end
    function sig:Fire(...)
      for _, fn in ipairs(sig._cons) do pcall(fn, ...) end
    end
    return sig
  end
  local function makeElement(def)
    local el = { _value = def.Default, Changed = newSignal() }
    function el:Get() return el._value end
    function el:Set(v)
      el._value = v
      el.Changed:Fire(v)
      if def.Callback then def.Callback(v) end
    end
    function el:SetOptions(opts) el._options = opts end
    function el:Press() if def.Callback then def.Callback() end end
    function el:Write(msg) print("[log] " .. tostring(msg)) end
    function el:Clear() print("[log] cleared") end
    return el
  end
  local function makeTab(name)
    print("[ui] tab '" .. tostring(name) .. "' ready")
    local tab = {}
    function tab:AddToggle(def) return makeElement(def) end
    function tab:AddSlider(def) return makeElement(def) end
    function tab:AddButton(def) return makeElement(def) end
    function tab:AddDropdown(def) return makeElement(def) end
    function tab:AddLabel(text, _) return makeElement({ Default = text }) end
    function tab:AddConsole(_) return makeElement({}) end
    function tab:AddSeparator() end
    function tab:AddTextBox(def) return makeElement(def) end
    return tab
  end
  local ui = {}
  function ui:CreateWindow(def)
    print("[ui] window '" .. tostring(def.Title) .. "' ready (fallback mode, no real rendering)")
    local win = {}
    function win:AddTab(name, _) return makeTab(name) end
    function win:CreateTag(...) end
    function win:Notify(n) print("Notify [" .. tostring(n.Title) .. "] " .. tostring(n.Text)) end
    function win:Destroy() print("[ui] window destroyed") end
    win.Gui = nil
    return win
  end
  VantixUI = ui
end

