task.spawn(function()
  -- real executor: background loop. skipped in the mock (each Run executes once;
  -- the demo sweep below shows the same behaviour, buttons drive the rest).
  if FALLBACK then return end
  while true do
    if Flags.Auto then
      collectPass(false)
      if #(findChests()) == 0 and Flags.Collected > 0 then
        status:Set("Status: all chests collected")
      end
    end
    task.wait(Flags.Delay)
  end
end)

