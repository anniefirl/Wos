  if not hasAnyPrompt() then buildDemoWorld() end
  print("Demo: running one automatic sweep so you can watch it work.")
  collectPass(false)
  print("Demo sweep done: " .. Flags.Collected .. " opened. Flip Auto Collect for the loop.")
end

