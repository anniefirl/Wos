if FALLBACK then
  print("Demo: Serene running with display stubs (no live game).")
  Flags.DropsLoaded = loadModule("Drops")
  if dropsLoadedLabel then dropsLoadedLabel:Set("Drops module: ready") end
  refreshCounter(0, 54)
  do
    local function makeDemoNpc(name, x)
      local m = Instance.new("Model")
      m.Name = name
      local rp = Instance.new("Part")
      rp.Name = "HumanoidRootPart"
      rp.Position = Vector3.new(x, 3, 0)
      rp.Anchored = true
      rp.Parent = m
      return m
    end
    local char = Instance.new("Model")
    char.Name = "Player1"
    local hrp = Instance.new("Part")
    hrp.Name = "HumanoidRootPart"
    hrp.Position = Vector3.new(0, 5, 0)
    hrp.Parent = char
    char.Parent = workspace
    LP.Character = char
    makeDemoNpc("Slugger", 40).Parent = workspace
    makeDemoNpc("Vampire Capo", 80).Parent = workspace
    print("Demo: 2 npcs placed (stand-ins).")
    npcTarget = "All"
    local n = farmNpcsOnce()
    say("NPC demo: visited " .. n)
    -- demo chests 1..8: firing the prompt marks them opened, the way a
    -- real game server would. then a real ordered sweep collects them.
    local function makeDemoChest(i)
      local m = Instance.new("Model")
      m.Name = tostring(i)
      local part = Instance.new("Part")
      part.Name = "ChestPart"
      part.Position = Vector3.new(-60 + i * 16, 3, (i % 2) * 30 - 15)
      part.Anchored = true
      part.Parent = m
      local opened = Instance.new("BoolValue")
      opened.Name = "Opened"
      opened.Value = false
      opened.Parent = m
      local prompt = Instance.new("ProximityPrompt")
      prompt.HoldDuration = 0.5
      prompt.MaxActivationDistance = 10
      prompt.Parent = part
      prompt.Triggered:Connect(function() opened.Value = true end)
      return m
    end
    for i = 1, 8 do makeDemoChest(i).Parent = workspace end
    print("Demo: 8 chests placed (stand-ins for your 1..54).")
    local savedFrom, savedTo = Flags.From, Flags.To
    Flags.From, Flags.To = 1, 8
    collectOrdered(nil)
    Flags.From, Flags.To = savedFrom, savedTo
    updateChestCount()
    say("Chest demo: 8/8 opened")
  end
  setStatus("Status: ready - pick a tab")
  say("Demo done: main window ready.")
end

