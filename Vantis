local LP = Players.LocalPlayer

local Flags = { Auto = false, Radius = 200, Delay = 0.5, Method = "Teleport",
  From = 1, To = 54, Collected = 0, RemoteName = "OpenChest" }

local avail = {}       -- [num] = last seen state: nil unknown, true available, false gone, "tried" fired, waiting
local memory = {}      -- [num] = last seen position (lets us walk back to unstreamed chests)
local lastSeen = {}    -- nums present in the latest scan, available or not
local openedSet = {}   -- nums opened at least once
local uniqueOpened = 0
local totalOpens = 0

-- created by the UI below, callbacks only use them later
local status, countLabel, console
local openRemote
local getRemote -- forward: defined with the resolver below, used by collectOne above it

local function getHRP()
  local char = LP.Character
  if char then
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then return hrp end
  end
  char = Instance.new("Model")
  char.Name = LP.Name or "Player1"
  local hrp = Instance.new("Part")
  hrp.Name = "HumanoidRootPart"
  hrp.Position = Vector3.new(0, 5, 0)
  hrp.Anchored = true
  hrp.Parent = char
  char.Parent = workspace
  LP.Character = char
  return hrp
end

local function chestNum(model)
  local n = tonumber(model.Name)
  if n and n >= Flags.From and n <= Flags.To then return n end
  return nil
end

local function chestOf(prompt)
  local node = prompt.Parent
  for _ = 1, 3 do
    if node == nil then return nil end
    if node.FindFirstChild and node:FindFirstChild("Opened") then return node end
    if node.Name and chestNum(node) then return node end
    node = node.Parent
  end
  return nil
end

local function dist3(a, b)
  local dx = a.X - b.X
  local dy = a.Y - b.Y
  local dz = a.Z - b.Z
  return math.sqrt(dx * dx + dy * dy + dz * dz)
end

local function rangeSize()
  return math.max(1, Flags.To - Flags.From + 1)
end

-- Event-driven chest cache: one full scan, then incremental updates.
-- This replaces scanning the whole workspace every pass (the old lag source).
local cache = {} -- [num] = { model=, prompt=, opened=, part= }
local cacheReady = false
local function firstOf(model, className)
  for _, x in ipairs(model:GetDescendants()) do
    if x.ClassName == className then return x end
  end
  return nil
end
local function modelOf(node)
  local cur = node
  for _ = 1, 4 do
    if cur == nil then return nil end
    if cur.ClassName == "Model" and chestNum(cur) then return cur end
    cur = cur.Parent
  end
  return nil
end
local function cacheAdd(model)
  local num = chestNum(model)
  if not num then return end
  local part = model:FindFirstChild("ChestPart", true) or firstOf(model, "Part")
  cache[num] = {
    model = model, num = num, part = part,
    prompt = firstOf(model, "ProximityPrompt"),
    opened = model:FindFirstChild("Opened"),
  }
end
local function cacheRemoveNum(num)
  cache[num] = nil
  avail[num] = false
end
local function buildCache()
  cache = {}
  for _, d in ipairs(workspace:GetDescendants()) do
    if d.ClassName == "Model" and chestNum(d) then cacheAdd(d) end
  end
  local n = 0
  for _ in pairs(cache) do n = n + 1 end
  print("Chest cache: " .. n .. " chests tracked")
end
local function registerCacheHandlers()
  if cacheReady then return end
  cacheReady = true
  workspace.DescendantAdded:Connect(function(d)
    local m = modelOf(d)
    if m then cacheAdd(m) end
  end)
  workspace.DescendantRemoving:Connect(function(d)
    local m = nil
    if d.ClassName == "Model" and chestNum(d) then
      m = d
    else
      local cur = d.Parent
      for _ = 1, 4 do
        if cur == nil then break end
        if cur.ClassName == "Model" and chestNum(cur) then m = cur break end
        cur = cur.Parent
      end
    end
    if m then
      local n = chestNum(m)
      if n then cacheRemoveNum(n) end
    end
  end)
end

-- One scan doubles as respawn detector: anything that was gone and is back
-- gets collected again; one-and-done chests stay untouched once opened.
local function findChests()
  local out = {}
  lastSeen = {}
  if not cacheReady then buildCache() registerCacheHandlers() end
  local hrp = getHRP()
  if not hrp then return out end
  for num, e in pairs(cache) do
    if e.model.Parent ~= nil and e.prompt and e.part and e.part.Position then
      lastSeen[num] = true
      memory[num] = e.part.Position
      local promptOn = (e.prompt.Enabled ~= false)
      local available = promptOn and ((e.opened == nil) or (not e.opened.Value))
      local last = avail[num]
      if available then
        local entry = { prompt = e.prompt, chest = e.model, num = num, part = e.part,
          dist = dist3(hrp.Position, e.part.Position) }
          if last == nil or last == false then
            if last == false and console then
              console:Write("Chest " .. num .. " respawned")
            end
            out[#out + 1] = entry
            avail[num] = (e.opened ~= nil) and "tried" or true
          elseif last == "tried" then
            if e.opened ~= nil and not e.opened.Value then
              out[#out + 1] = entry -- server didn't open it last pass, retry
            else
              avail[num] = true
            end
          end
        else
          avail[num] = false
        end
    end
  end
  table.sort(out, function(a, b) return a.dist < b.dist end)
  -- in-range filter last so availability memory stays fresh for everything
  local inRange = {}
  for _, c in ipairs(out) do
    if c.dist <= Flags.Radius then inRange[#inRange + 1] = c end
  end
  return inRange
end

-- instant collect: zero the hold time, then fire. never throws: if the
-- prompt can't be fired on this client, the remote call below still runs.
local function holdPrompt(prompt)
  pcall(function()
    prompt.HoldDuration = 0
    prompt.MaxActivationDistance = 1000
  end)
  if typeof(fireproximityprompt) == "function" then
    pcall(fireproximityprompt, prompt)
  elseif prompt.Triggered and typeof(prompt.Triggered.Fire) == "function" then
    pcall(function() prompt.Triggered:Fire(LP) end)
  end
end

local function collectOne(c)
  local hrp = getHRP()
  if not hrp then return false end
  local p = c.part.Position
  if Flags.Method == "Tween" then
    local from = hrp.Position
    for i = 1, 10 do
      local t = i / 10
      hrp.CFrame = CFrame.new(
        from.X + (p.X - from.X) * t,
        from.Y + (p.Y - from.Y) * t + 3,
        from.Z + (p.Z - from.Z) * t)
      task.wait(0.05)
    end
  else
    hrp.CFrame = CFrame.new(p.X, p.Y + 3, p.Z)
  end
  if status then status:Set("Status: opening chest " .. c.num) end
  task.wait(0.2)
  holdPrompt(c.prompt)
  local rem = getRemote()
  if not rem then
    if console and not warnedNoRemote then
      console:Write("No chest remote found - set Remote Name or press Rebuild")
      warnedNoRemote = true
    end
    return false
  end
  rem:FireServer(c.chest)
  return true
end

local visitRemembered -- forward: defined below, used by collectPass
local function collectPass(onlyNearest)
  local list = findChests()
  if status then status:Set("Status: " .. #list .. " chest(s) in range") end
  local n = 0
  for i, c in ipairs(list) do
    if onlyNearest and i > 1 then break end
    collectOne(c)
    n = n + 1
    task.wait(Flags.Delay)
  end
  -- phase 2: walk back to remembered chests that aren't rendered right now
  if not onlyNearest then
    local missing = {}
    for num, pos in pairs(memory) do
      if not lastSeen[num] and num >= Flags.From and num <= Flags.To then
        missing[#missing + 1] = { num = num, pos = pos }
      end
    end
    table.sort(missing, function(a, b) return a.num < b.num end)
    for _, m in ipairs(missing) do
      if status then status:Set("Status: checking unstreamed chest " .. m.num) end
      visitRemembered(m.num, m.pos)
    end
  end
  return n
end

-- walk back to a remembered chest whose area isn't rendered: teleport over,
-- ask the server to stream the area in, wait for it, then collect.
-- waits on the cache (fed by DescendantAdded), never on full workspace scans.
visitRemembered = function(num, pos)
  local hrp = getHRP()
  if not hrp then return end
  hrp.CFrame = CFrame.new(pos.X, pos.Y + 3, pos.Z)
  if typeof(LP.RequestStreamAroundAsync) == "function" then
    LP:RequestStreamAroundAsync(pos)
  end
  for _ = 1, 10 do
    task.wait(0.5)
    local e = cache[num]
    if e and e.prompt and e.part and e.part.Position then
      local promptOn = (e.prompt.Enabled ~= false)
      if promptOn and ((e.opened == nil) or (not e.opened.Value)) then
        if console then console:Write("Chest " .. num .. " streamed in") end
        collectOne({ prompt = e.prompt, chest = e.model, num = num, part = e.part, dist = 0 })
        task.wait(Flags.Delay)
        return
      elseif e.opened ~= nil and e.opened.Value then
        return -- streamed, but already opened: nothing to do
      end
    end
  end
  if console then console:Write("Chest " .. num .. " did not stream in, will retry") end
end

