local clickGui -- forward: defined with the drop helpers below

local function findInventoryGui()
  local pg = getPlayerGui()
  if not pg then return nil end
  -- this game's frame first, then generic matches
  local exact = nil
  pcall(function() exact = pg:FindFirstChild("InventoryFrame", true) end)
  if exact then return exact end
  pcall(function() exact = pg:FindFirstChild("Inventory", true) end)
  if exact then return exact end
  local found = nil
  pcall(function()
    for _, d in ipairs(pg:GetDescendants()) do
      if d.Name and string.find(string.lower(d.Name), "inventory") then
        found = d
        break
      end
    end
  end)
  return found
end

local function setGuiOpen(gui, open)
  if not gui then return end
  pcall(function()
    if gui.ClassName == "ScreenGui" then
      gui.Enabled = open
    else
      gui.Visible = open
    end
  end)
  -- ensure parents are visible/enabled up to PlayerGui
  pcall(function()
    local cur = gui.Parent
    while cur and cur.ClassName ~= "PlayerGui" and cur.ClassName ~= "DataModel" do
      if cur.IsA and cur:IsA("GuiObject") then cur.Visible = true end
      if cur.ClassName == "ScreenGui" then cur.Enabled = true end
      cur = cur.Parent
    end
  end)
end

local function isGuiOpen(gui)
  local open = true
  pcall(function()
    if gui.ClassName == "ScreenGui" then
      open = gui.Enabled == true
    elseif gui.Visible ~= nil then
      open = gui.Visible == true
    end
  end)
  return open
end

-- the button players tap to open the bag (used when forcing Visible is not enough)
local function findInventoryToggle()
  local pg = getPlayerGui()
  if not pg then return nil end
  local all = nil
  pcall(function() all = pg:GetDescendants() end)
  if not all then return nil end
  for _, d in ipairs(all) do
    if d.ClassName == "TextButton" or d.ClassName == "ImageButton" then
      local vis = true
      pcall(function() vis = d.Visible ~= false end)
      if vis then
        local hit = false
        pcall(function()
          local n = string.lower(d.Name or "")
          if string.find(n, "invent") or string.find(n, "bag") or string.find(n, "backpack") then hit = true end
        end)
        if not hit then
          pcall(function()
            local t = string.lower(d.Text or "")
            if string.find(t, "invent") or string.find(t, "bag") or string.find(t, "backpack") then hit = true end
          end)
        end
        if hit then return d end
      end
    end
  end
  return nil
end

local function openInventory()
  local gui = findInventoryGui()
  if not gui then
    setStatus("Status: inventory GUI not found")
    say("Inventory GUI not found (looked for 'InventoryFrame' in PlayerGui)")
    return false
  end
  setGuiOpen(gui, true)
  task.wait(0.3)
  if isGuiOpen(gui) then
    setStatus("Status: inventory open")
    say("Inventory opened")
    return true
  end
  -- game keeps it shut: tap its own toggle button like a player would
  local toggle = findInventoryToggle()
  if toggle then
    clickGui(toggle)
    task.wait(0.5)
    if isGuiOpen(gui) then
      setStatus("Status: inventory open")
      say("Inventory opened")
      return true
    end
  end
  setStatus("Status: inventory may still be closed - continuing anyway")
  say("Inventory would not stay open - continuing anyway")
  return true
end

-- Drop spot: while auto drop runs, the player is frozen here, standing upright.
-- (Pitching the root part lays the whole rig flat, which left the character
-- positioned wrong - so the character stands and the camera looks down instead.)
local DropSpotX, DropSpotY, DropSpotZ = 298, 17, 207

local function zeroMotion(hrp)
  pcall(function()
    hrp.Velocity = Vector3.zero
    hrp.RotVelocity = Vector3.zero
  end)
  pcall(function()
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
  end)
end

local function dropSpotCFrame()
  return CFrame.new(DropSpotX, DropSpotY, DropSpotZ)
end

-- full freeze: unanchor FIRST (a CFrame set on an already-anchored part does
-- not always replicate, so the server snaps the character back), kill all
-- velocity, double-set the standing CFrame, then anchor. camera looks down
-- at the drop pile.
local function freezeAtDropSpot()
  local hrp = getHRP()
  if not hrp then return nil end
  pcall(function() hrp.Anchored = false end)
  zeroMotion(hrp)
  pcall(function() hrp.CFrame = dropSpotCFrame() end)
  task.wait(0.15)
  pcall(function() hrp.CFrame = dropSpotCFrame() end)
  zeroMotion(hrp)
  pcall(function() hrp.Anchored = true end)
  pcall(function()
    local cam = workspace.CurrentCamera
    if cam then
      cam.CFrame = CFrame.new(
        Vector3.new(DropSpotX, DropSpotY + 14, DropSpotZ + 4),
        Vector3.new(DropSpotX, DropSpotY, DropSpotZ))
    end
  end)
  return hrp
end

-- light maintenance between drops: only re-teleport when drifted more than
-- 2.5 studs (no more constant teleport spam), always hold the anchor.
local function holdDropSpot()
  pcall(function()
    local hrp = getHRP()
    if not hrp then return end
    local drifted = true
    pcall(function()
      local p = hrp.Position
      local dx = p.X - DropSpotX
      local dy = p.Y - DropSpotY
      local dz = p.Z - DropSpotZ
      drifted = math.sqrt(dx * dx + dy * dy + dz * dz) > 2.5
    end)
    if drifted then
      zeroMotion(hrp)
      hrp.CFrame = dropSpotCFrame()
    end
    hrp.Anchored = true
  end)
end

local function unfreezeNow()
  pcall(function()
    local hrp = getHRP()
    if hrp then hrp.Anchored = false end
  end)
end

-- Drop All: priority order, click each item then drop until its count is 0.
local DropOrder = {"Legendary Arrow", "Shiny Arrow", "Stand Arrow", "Locacaca Fruit"}

-- clicks a GuiButton the way a real click does: fire EVERY signal the game
-- could listen on (down + click + activated + connections + Activate).
-- never throws. returns true if anything was attempted.
clickGui = function(btn)
  if btn == nil then return false end
  local clicked = false
  pcall(function()
    if typeof(firesignal) == "function" and btn.MouseButton1Down then
      firesignal(btn.MouseButton1Down)
      clicked = true
    end
  end)
  pcall(function()
    if typeof(firesignal) == "function" and btn.MouseButton1Click then
      firesignal(btn.MouseButton1Click)
      clicked = true
    end
  end)
  pcall(function()
    if typeof(getconnections) == "function" then
      for _, sigName in ipairs({"MouseButton1Click", "MouseButton1Down", "Activated"}) do
        local sig = btn[sigName]
        if sig then
          for _, c in ipairs(getconnections(sig)) do
            pcall(function() c:Fire() end)
            clicked = true
          end
        end
      end
    end
  end)
  pcall(function()
    if btn.Activate then
      btn:Activate()
      clicked = true
    end
  end)
  pcall(function()
    if typeof(firesignal) == "function" and btn.Activated then
      firesignal(btn.Activated)
      clicked = true
    end
  end)
  return clicked
end

local function parseSlotCount(slot)
  local count = 1
  local foundNumber = false
  local function scanText(t)
    if type(t) ~= "string" then return end
    local m = string.match(t, "[xX]%s*(%d+)")
    if m then
      count = tonumber(m)
      foundNumber = true
      return
    end
    local m2 = string.match(t, "^%s*(%d+)%s*$")
    if m2 and not foundNumber then
      count = tonumber(m2)
      foundNumber = true
    end
  end
  pcall(function() scanText(slot.Text) end)
  pcall(function()
    for _, d in ipairs(slot:GetDescendants()) do
      if d.ClassName == "TextLabel" or d.ClassName == "TextButton" then
        local t = nil
        pcall(function() t = d.Text end)
        scanText(t)
      end
    end
  end)
  return count
end

-- returns slot gui + count for an item inside one container (frame scope)
local function findItemSlotIn(container, itemName)
  if not container then return nil end
  local want = string.lower(itemName)
  local all = nil
  pcall(function() all = container:GetDescendants() end)
  if not all then return nil end
  for _, d in ipairs(all) do
    local cls = d.ClassName
    if cls == "TextButton" or cls == "ImageButton" or cls == "Frame" or cls == "ImageLabel" or cls == "TextLabel" then
      local match = false
      pcall(function()
        if d.Name and string.lower(d.Name) == want then match = true end
      end)
      if not match then
        pcall(function()
          if d.Text and string.lower(d.Text) == want then match = true end
        end)
      end
      if not match then
        pcall(function()
          for _, c in ipairs(d:GetDescendants()) do
            if c.ClassName == "TextLabel" and c.Text and string.lower(c.Text) == want then
              match = true
              break
            end
          end
        end)
      end
      if match then
        return d, parseSlotCount(d)
      end
    end
  end
  return nil
end

-- frame first ("fetch" scope), whole PlayerGui as fallback
local function findItemSlot(itemName)
  local frame = findInventoryGui()
  if frame then
    local fs, fc = findItemSlotIn(frame, itemName)
    if fs then return fs, fc end
  end
  local pg = getPlayerGui()
  if pg then
    return findItemSlotIn(pg, itemName)
  end
  return nil
end

-- reads the frame's item entries ("fetch data"): logs every DropOrder item
-- with its count, returns the ones actually present.
local function fetchInventoryData()
  local data = {}
  local frame = findInventoryGui()
  if not frame then
    say("Fetch: no InventoryFrame found")
    return data
  end
  local n = 0
  pcall(function()
    local all = frame:GetDescendants()
    if all then n = #all end
  end)
  say("Fetch: '" .. tostring(frame.Name) .. "' has " .. n .. " descendants")
  for _, itemName in ipairs(DropOrder) do
    local fs, fc = findItemSlotIn(frame, itemName)
    if fs then
      data[#data + 1] = { slot = fs, name = itemName, count = fc or 1 }
      say("Fetch: " .. itemName .. " x" .. (fc or 1))
    else
      say("Fetch: " .. itemName .. " x0")
    end
  end
  return data
end

-- finds a tool by name in Backpack AND Character (equipping moves it to
-- Character - only checking Backpack reported "dropped" while still held).
local function findHeldTool(itemName)
  local want = string.lower(itemName)
  local found = nil
  local function searchContainer(cont)
    if not cont or found then return end
    pcall(function()
      for _, c in ipairs(cont:GetChildren()) do
        if c.Name and string.lower(c.Name) == want then
          found = c
          break
        end
      end
    end)
  end
  local pack = nil
  pcall(function()
    if LP and LP.FindFirstChild then pack = LP:FindFirstChild("Backpack") end
  end)
  if not pack then
    pcall(function() if LP then pack = LP.Backpack end end)
  end
  searchContainer(pack)
  local char = nil
  pcall(function() if LP then char = LP.Character end end)
  searchContainer(char)
  return found
end

local function findDropButton()
  local pg = getPlayerGui()
  if not pg then return nil end
  for _, nm in ipairs({"Drop", "DropItem", "DropAll", "Discard", "Delete", "Trash"}) do
    local b = nil
    pcall(function() b = pg:FindFirstChild(nm, true) end)
    if b then return b end
  end
  local all = nil
  pcall(function() all = pg:GetDescendants() end)
  if all then
    for _, d in ipairs(all) do
      if d.ClassName == "TextButton" or d.ClassName == "ImageButton" then
        local hit = false
        pcall(function()
          if d.Name and string.find(string.lower(d.Name), "drop") then hit = true end
        end)
        if not hit then
          pcall(function()
            if d.Text and string.find(string.lower(d.Text), "drop") then hit = true end
          end)
        end
        if hit then return d end
      end
    end
  end
  return nil
end

-- confirmation popup after Drop: the game spells it "Conform"
local function findConfirmButton(exceptBtn)
  local pg = getPlayerGui()
  if not pg then return nil end
  for _, nm in ipairs({"Conform", "Confirm", "Yes", "OK"}) do
    local b = nil
    pcall(function() b = pg:FindFirstChild(nm, true) end)
    if b and b ~= exceptBtn then return b end
  end
  local all = nil
  pcall(function() all = pg:GetDescendants() end)
  if all then
    for _, d in ipairs(all) do
      if (d.ClassName == "TextButton" or d.ClassName == "ImageButton") and d ~= exceptBtn then
        local hit = false
        pcall(function()
          local n = string.lower(d.Name or "")
          if string.find(n, "conform") or string.find(n, "confirm") then hit = true end
        end)
        if not hit then
          pcall(function()
            local t = string.lower(d.Text or "")
            if string.find(t, "conform") or string.find(t, "confirm") then hit = true end
          end)
        end
        if hit then return d end
      end
    end
  end
  return nil
end

local dropRemote = nil
local warnedNoDropRemote = false

local function resolveDropRemote()
  local okRs, rs = pcall(function() return game:GetService("ReplicatedStorage") end)
  if not okRs or not rs then return nil end
  local all = nil
  pcall(function() all = rs:GetDescendants() end)
  if not all then return nil end
  for _, d in ipairs(all) do
    if d.ClassName == "RemoteEvent" or d.ClassName == "UnreliableRemoteEvent" or d.ClassName == "RemoteFunction" then
      local nm = string.lower(d.Name)
      if string.find(nm, "drop") or string.find(nm, "discard") then return d end
    end
  end
  return nil
end

local function getDropRemote()
  if dropRemote and dropRemote.Parent ~= nil then return dropRemote end
  dropRemote = resolveDropRemote()
  return dropRemote
end

local function tryDropRemote(handle, itemName)
  local rem = getDropRemote()
  if not rem then
    if not warnedNoDropRemote then
      say("No drop remote found - GUI drop only")
      warnedNoDropRemote = true
    end
    return
  end
  if rem.ClassName == "RemoteFunction" then
    if handle then pcall(function() rem:InvokeServer(handle) end)
    else pcall(function() rem:InvokeServer(itemName) end) end
  else
    if handle then pcall(function() rem:FireServer(handle) end) end
    pcall(function() rem:FireServer(itemName) end)
  end
end

-- drops ONE item name until its count is 0. held tools (backpack + character)
-- first, GUI slots second. returns ok, saw.
local function dropOneOf(itemName, myToken)
  local noProgress = 0
  local saw = false
  for attempt = 1, 30 do
    if cancelled(myToken) then setStatus("Status: stopped") return false, saw end
    holdDropSpot()
    local slot = nil
    local count = 0
    local isTool = false
    local tool = findHeldTool(itemName)
    if tool then
      slot = tool
      count = 1
      isTool = true
      saw = true
    else
      local gs, gc = findItemSlot(itemName)
      if not gs then
        return true, saw
      end
      slot = gs
      count = gc or 1
      saw = true
    end
    setStatus("Status: drop [" .. itemName .. "] (" .. count .. " left)...")
    if isTool then
      -- equip it so the Drop button / Backspace has something to drop
      pcall(function()
        local char = LP.Character
        local hum = nil
        if char then
          if char.FindFirstChildOfClass then hum = char:FindFirstChildOfClass("Humanoid")
          else hum = char:FindFirstChild("Humanoid") end
        end
        if hum and hum.EquipTool then hum:EquipTool(slot) end
      end)
      task.wait(0.3)
    else
      clickGui(slot)
      task.wait(0.4)
    end
    if cancelled(myToken) then setStatus("Status: stopped") return false, saw end
    -- recount tools first: gone from hands AND pack means actually dropped
    local t2 = findHeldTool(itemName)
    local s2, c2 = nil, nil
    if not t2 then s2, c2 = findItemSlot(itemName) end
    if not t2 and not s2 then
      return true, saw
    end
    local progressed = (not isTool) and s2 and (c2 or 1) < count
    if progressed then
      noProgress = 0
    else
      -- select/equip alone did nothing: Drop button, then remote, then Backspace
      local dropBtn = findDropButton()
      if dropBtn then
        clickGui(dropBtn)
        task.wait(0.4)
        -- confirmation popup after Drop ("Conform" in this game)
        local confirmBtn = findConfirmButton(dropBtn)
        if confirmBtn then
          clickGui(confirmBtn)
          say("Conform pressed for " .. itemName)
        end
        task.wait(0.5)
        if cancelled(myToken) then setStatus("Status: stopped") return false, saw end
      end
      local t3 = findHeldTool(itemName)
      local s3, c3 = nil, nil
      if not t3 then s3, c3 = findItemSlot(itemName) end
      if not t3 and not s3 then return true, saw end
      local progressed2 = (not isTool) and s3 and (c3 or 1) < count
      if progressed2 then
        noProgress = 0
      else
        tryDropRemote(t3 or s3, itemName)
        task.wait(0.5)
        if isTool then
          -- last resort: Backspace drops the equipped tool in default backpacks
          pcall(function()
            local vim = game:GetService("VirtualInputManager")
            if vim and vim.SendKeyEvent then
              vim:SendKeyEvent(true, Enum.KeyCode.Backspace, false, game)
              task.wait(0.1)
              vim:SendKeyEvent(false, Enum.KeyCode.Backspace, false, game)
            end
          end)
          task.wait(0.3)
        end
        if cancelled(myToken) then setStatus("Status: stopped") return false, saw end
        local t4 = findHeldTool(itemName)
        local s4, c4 = nil, nil
        if not t4 then s4, c4 = findItemSlot(itemName) end
        if not t4 and not s4 then return true, saw end
        local progressed3 = (not isTool) and s4 and (c4 or 1) < count
        if progressed3 then noProgress = 0
        else noProgress = noProgress + 1 end
      end
    end
    if cancelled(myToken) then setStatus("Status: stopped") return false, saw end
    if noProgress >= 3 then
      setStatus("Status: drop [" .. itemName .. "] stuck, moving on")
      say("Could not drop " .. itemName .. " - leaving it and moving on")
      return false, saw
    end
    task.wait(0.4)
  end
  setStatus("Status: drop [" .. itemName .. "] gave up after 30 tries")
  return false, saw
end

-- priority order: legendary -> shiny -> stand -> locacaca, each until 0.
local function dropAllPriority(myToken)
  if cancelled(myToken) then setStatus("Status: stopped") return 0, false end
  freezeAtDropSpot()
  openInventory()
  if cancelled(myToken) then setStatus("Status: stopped") return 0 end
  fetchInventoryData()
  if cancelled(myToken) then setStatus("Status: stopped") return 0 end
  local emptied = 0
  local sawAny = false
  for _, itemName in ipairs(DropOrder) do
    if cancelled(myToken) then setStatus("Status: stopped") return emptied, sawAny end
    setStatus("Status: drop [" .. itemName .. "]...")
    local ok, saw = dropOneOf(itemName, myToken)
    if saw then sawAny = true end
    if ok then emptied = emptied + 1 end
    if cancelled(myToken) then setStatus("Status: stopped") return emptied, sawAny end
    task.wait(0.3)
  end
  if cancelled(myToken) then setStatus("Status: stopped") return emptied, sawAny end
  setStatus("Status: drop done - arrows/fruit at 0")
  say("Drop All done")
  return emptied, sawAny
end

-- Scan: dumps PlayerGui tree + backpack + drop/inventory remotes into the log
-- so a mismatched GUI name can be identified. never throws.
local function scanGameGui()
  local who = "?"
  pcall(function() if LP then who = tostring(LP.Name) end end)
  say("Scan: PlayerGui of " .. who)
  local pg = getPlayerGui()
  if not pg then
    say("Scan: no PlayerGui found")
  else
    local all = nil
    pcall(function() all = pg:GetDescendants() end)
    if all then
      say("Scan: PlayerGui has " .. #all .. " descendants (first 80):")
      for i = 1, math.min(#all, 80) do
        local d = all[i]
        local extra = ""
        pcall(function()
          if d.Text then extra = " text=" .. tostring(d.Text) end
        end)
        say("  " .. d.ClassName .. " '" .. tostring(d.Name) .. "'" .. extra)
      end
    end
  end
  pcall(function()
    local pack = LP and LP.FindFirstChild and LP:FindFirstChild("Backpack")
    if pack then
      local kids = pack:GetChildren()
      say("Scan: backpack has " .. #kids .. " items:")
      for _, c in ipairs(kids) do
        say("  backpack: " .. c.ClassName .. " '" .. tostring(c.Name) .. "'")
      end
    else
      say("Scan: no Backpack")
    end
  end)
  pcall(function()
    local char = LP and LP.Character
    if char then
      for _, c in ipairs(char:GetChildren()) do
        if c.ClassName == "Tool" then
          say("  equipped: Tool '" .. tostring(c.Name) .. "'")
        end
      end
    end
  end)
  pcall(function()
    local rs = game:GetService("ReplicatedStorage")
    for _, d in ipairs(rs:GetDescendants()) do
      if d.ClassName == "RemoteEvent" or d.ClassName == "RemoteFunction" then
        local nm = string.lower(d.Name)
        if string.find(nm, "drop") or string.find(nm, "discard") or string.find(nm, "invent") then
          say("Scan remote: " .. d.ClassName .. " '" .. tostring(d.Name) .. "'")
        end
      end
    end
  end)
  say("Scan done - share the lines above")
end

