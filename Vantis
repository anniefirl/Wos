local FALLBACK = (VantixUI == nil)

if FALLBACK then
  local function newSignal()
    local sig = { _cons = {} }
    function sig:Connect(fn)
      table.insert(sig._cons, fn)
      return { Connected = true, Disconnect = function() end }
    end
    function sig:Fire(...)
      for _, fn in ipairs(sig._cons) do pcall(fn, ...) end
    end
    return sig
  end
  local function makeElement(def)
    local el = { _value = def.Default, Changed = newSignal() }
    function el:Get() return el._value end
    function el:Set(v)
      el._value = v
      el.Changed:Fire(v)
      if def.Callback then def.Callback(v) end
    end
    function el:SetOptions(opts) el._options = opts end
    function el:Press() if def.Callback then def.Callback() end end
    function el:Write(msg) print("[log] " .. tostring(msg)) end
    function el:Clear() print("[log] cleared") end
    return el
  end
  local function makeTab(name)
    print("[ui] tab '" .. tostring(name) .. "' ready")
    local tab = {}
    function tab:AddToggle(def) return makeElement(def) end
    function tab:AddSlider(def) return makeElement(def) end
    function tab:AddButton(def) return makeElement(def) end
    function tab:AddDropdown(def) return makeElement(def) end
    function tab:AddMultiDropdown(def) return makeElement(def) end
    function tab:AddLabel(text, _) return makeElement({ Default = text }) end
    function tab:AddConsole(_) return makeElement({}) end
    function tab:AddSeparator() end
    function tab:AddTextBox(def) return makeElement(def) end
    return tab
  end
  local ui = {}
  function ui:CreateWindow(def)
    print("[ui] window '" .. tostring(def.Title) .. "' ready (fallback mode, no real rendering)")
    local win = {}
    function win:AddTab(name, _) return makeTab(name) end
    function win:CreateTag(...) end
    function win:Notify(n) print("Notify [" .. tostring(n.Title) .. "] " .. tostring(n.Text)) end
    function win:Destroy() print("[ui] window destroyed") end
    win.Gui = nil
    return win
  end
  VantixUI = ui
end

