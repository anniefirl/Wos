local dropRemote = nil
local warnedNoDropRemote = false
local dropRemoteCheckedAt = 0

local function resolveDropRemote()
  local okRs, rs = pcall(function() return game:GetService("ReplicatedStorage") end)
  if not okRs or not rs then return nil end
  local all = nil
  pcall(function() all = rs:GetDescendants() end)
  if not all then return nil end
  for _, d in ipairs(all) do
    if d.ClassName == "RemoteEvent" or d.ClassName == "UnreliableRemoteEvent" or d.ClassName == "RemoteFunction" then
      local nm = string.lower(d.Name)
      if string.find(nm, "drop") or string.find(nm, "discard") then return d end
    end
  end
  return nil
end

local function getDropRemote()
  if dropRemote and dropRemote.Parent ~= nil then return dropRemote end
  -- negative cache: ReplicatedStorage walks are expensive, so a miss is
  -- only re-scanned every 30s instead of on every drop attempt.
  local now = tick()
  if dropRemote == nil and now - dropRemoteCheckedAt < 30 then
    return nil
  end
  dropRemote = resolveDropRemote()
  dropRemoteCheckedAt = now
  return dropRemote
end

local function tryDropRemote(handle, itemName)
  local rem = getDropRemote()
  if not rem then
    if not warnedNoDropRemote then
      say("No drop remote found - GUI drops use clicks/Backspace only")
      warnedNoDropRemote = true
    end
    return
  end
  -- one server call per fallback (was two: handle + name), calmer cadence.
  if rem.ClassName == "RemoteFunction" then
    if handle then pcall(function() rem:InvokeServer(handle) end)
    else pcall(function() rem:InvokeServer(itemName) end) end
  else
    if handle then pcall(function() rem:FireServer(handle) end)
    else pcall(function() rem:FireServer(itemName) end) end
  end
end

-- cheap exact-name check (engine-side FindFirstChild, no tree walk).
-- the popup is USUALLY literally named Conform, so most polls resolve
-- here and skip the expensive full-snapshot scan below.
local function findConfirmFast(frame, exceptBtn)
  if not frame then return nil end
  for _, nm in ipairs({"Conform", "Confirm", "Yes", "OK"}) do
    local b = nil
    pcall(function() b = frame:FindFirstChild(nm, true) end)
    if b and b ~= exceptBtn and btnUsable(b) then return b end
  end
  return nil
end

-- SPAM drop: arrows + fruit in RANDOM order, one unit per cycle, instead of
-- emptying legendary -> shiny -> stand -> locacaca in sequence. interleaving
-- is faster in-game (no per-stack stalls), and the bag only closes +
-- reopens every few units (batched rebuilds) instead of after every press.
-- TURBO: clicks are real either way - the waits were the whole cost, so
-- every wait stays cut to the bone (slot/drop 0.05s, confirm poll 30x0.05s,
-- settle 0.1s). perf: one shared frame snapshot per phase, never full
-- PlayerGui walks per attempt (that scan spam is what lagged the game).
-- never throws.

-- ONE spam cycle for a single item: slot -> Drop -> Conform, exactly one
-- unit. no rebuild inside (the caller batches those). returns "fired" (a
-- Conform press went out), "nosuch" (nothing by that name right now),
-- "stuck" (slot seen but no Drop/Conform press happened), or "stopped".
local function dropUnitOnce(itemName, myToken)
  if cancelledDrop(myToken) then return "stopped" end
  holdDropSpot()
  -- Multidrop toggle: tighter waits + shorter confirm window.
  local fast = Flags.MultiDrop and true or false
  local wClick = fast and 0.01 or 0.05
  local wSettle = fast and 0.03 or 0.1
  local pollN = fast and 12 or 30
  local pollW = fast and 0.03 or 0.05
  local tool = findHeldTool(itemName)
  local slot = nil
  if tool then
    slot = tool
  else
    local frame0, snap0 = snapshotFrame()
    local gs = nil
    if frame0 then
      gs = findItemSlotIn(frame0, itemName, snap0)
    else
      gs = findItemSlot(itemName)
    end
    if not gs then return "nosuch" end
    slot = gs
  end
  if tool then
    -- equip it so the Drop button has something to drop
    pcall(function()
      local char = LP.Character
      local hum = nil
      if char then
        if char.FindFirstChildOfClass then hum = char:FindFirstChildOfClass("Humanoid")
        else hum = char:FindFirstChild("Humanoid") end
      end
      if hum and hum.EquipTool then hum:EquipTool(slot) end
    end)
    task.wait(fast and 0.05 or 0.15)
  else
    clickGui(slot)
    task.wait(wClick)
  end
  if cancelledDrop(myToken) then return "stopped" end
  -- leftover confirmation first, then Drop + a fast poll for the popup.
  -- one snapshot serves both the pre-confirm and the Drop lookup.
  local frameB, snapB = snapshotFrame()
  local preConfirm = findConfirmButton(nil, frameB, snapB)
  if preConfirm then
    clickGui(preConfirm)
    say("Conform pressed for " .. itemName)
    task.wait(wSettle)
    return "fired"
  end
  local dropBtn = findDropButton(nil, frameB, snapB)
  if not dropBtn then return "stuck" end
  clickGui(dropBtn)
  task.wait(wClick)
  -- some games morph the SAME button into the confirm step:
  -- if it now reads conform/confirm, press it again directly.
  local morphed = false
  pcall(function()
    local t = string.lower(dropBtn.Text or "")
    if string.find(t, "conform") or string.find(t, "confirm") then morphed = true end
  end)
  if morphed then
    task.wait(wClick)
    clickGui(dropBtn)
    say("Conform pressed for " .. itemName)
    task.wait(wSettle)
    return "fired"
  end
  local confirmBtn = nil
  -- turbo poll: immediate check first (popup is usually already there
  -- after a real click), then short beats. normal = same ~1.5s window the
  -- patient version had at 0.25s; multidrop = ~0.36s window for speed.
  for i = 1, pollN do
    if cancelledDrop(myToken) then return "stopped" end
    local frameC = getInvFrame()
    confirmBtn = findConfirmFast(frameC, dropBtn)
    if not confirmBtn and i % 3 == 1 then
      local snapC = nil
      if frameC then pcall(function() snapC = frameC:GetDescendants() end) end
      confirmBtn = findConfirmButton(dropBtn, frameC, snapC)
    end
    if confirmBtn then break end
    task.wait(pollW)
  end
  if confirmBtn then
    clickGui(confirmBtn)
    say("Conform pressed for " .. itemName)
    task.wait(wSettle)
    return "fired"
  end
  return "stuck"
end

-- names currently droppable: held tools first, then one shared snapshot
-- for all four slot checks (was up to 8 full tree walks).
local function presentDropNames()
  local out = {}
  local have = {}
  for _, itemName in ipairs(DropOrder) do
    if findHeldTool(itemName) then
      out[#out + 1] = itemName
      have[itemName] = true
    end
  end
  local frame, snap = snapshotFrame()
  if frame then
    for _, itemName in ipairs(DropOrder) do
      if not have[itemName] and findItemSlotIn(frame, itemName, snap) then
        out[#out + 1] = itemName
      end
    end
  else
    for _, itemName in ipairs(DropOrder) do
      if not have[itemName] and findItemSlot(itemName) then
        out[#out + 1] = itemName
      end
    end
  end
  return out
end

-- rough total units left, for the stuck guard: held tools + one shared
-- snapshot sum. approximate is fine (held + slot double-counts).
local function totalDropUnits()
  local total = 0
  for _, itemName in ipairs(DropOrder) do
    if findHeldTool(itemName) then total = total + 1 end
  end
  local frame, snap = snapshotFrame()
  if frame then
    for _, itemName in ipairs(DropOrder) do
      local s, c = findItemSlotIn(frame, itemName, snap)
      if s then total = total + (c or 1) end
    end
  end
  return total
end

-- the spam loop: a random item every cycle until a fresh rebuild shows the
-- bag empty. the bag closes + reopens every 3rd cycle (batched rebuilds)
-- so the list updates without paying open/close on every unit. returns
-- units fired. never throws.
local function dropSpamRandom(myToken)
  if cancelledDrop(myToken) then setStatus("Status: stopped") return 0 end
  freezeAtDropSpot()
  if not chestHRP() then
    setStatus("Status: waiting for character...")
    task.wait(1)
    return 0
  end
  openInventory()
  if cancelledDrop(myToken) then setStatus("Status: stopped") return 0 end
  fetchInventoryData()
  local units = 0
  local flatRebuilds = 0
  local lastTotal = totalDropUnits()
  for cycle = 1, 200 do
    if cancelledDrop(myToken) then setStatus("Status: stopped") return units end
    holdDropSpot()
    local present = presentDropNames()
    if #present == 0 then
      -- confirm on a FRESH list: truly empty, or just ghosts.
      refreshInventory()
      if cancelledDrop(myToken) then setStatus("Status: stopped") return units end
      present = presentDropNames()
      if #present == 0 then
        refreshInventory()
        if cancelledDrop(myToken) then setStatus("Status: stopped") return units end
        setStatus("Status: drop done - arrows/fruit at 0")
        say("Drop spam done: " .. units .. " dropped")
        return units
      end
    end
    local itemName = present[1]
    pcall(function() itemName = present[math.random(1, #present)] end)
    setStatus("Status: drop [" .. itemName .. "]...")
    local res = dropUnitOnce(itemName, myToken)
    if res == "stopped" then setStatus("Status: stopped") return units end
    if res == "fired" then units = units + 1 end
    -- batched rebuilds: normal every 3rd cycle, multidrop every 5th.
    local every = Flags.MultiDrop and 5 or 3
    if cycle % every == 0 then
      refreshInventory()
      if cancelledDrop(myToken) then setStatus("Status: stopped") return units end
      local now = totalDropUnits()
      if now >= lastTotal then
        flatRebuilds = flatRebuilds + 1
      else
        flatRebuilds = 0
        lastTotal = now
      end
      if flatRebuilds >= 3 then
        -- 9+ (normal) / 15+ (multidrop) cycles with zero movement:
        -- one remote sweep, then stop.
        for _, nm in ipairs(presentDropNames()) do
          tryDropRemote(findHeldTool(nm), nm)
          task.wait(0.1)
        end
        refreshInventory()
        if totalDropUnits() >= lastTotal then
          setStatus("Status: drop stuck, stopping")
          say("Drop spam stuck - see log (press Scan GUI if this repeats)")
          return units
        end
        flatRebuilds = 0
      end
    else
      if Flags.MultiDrop then task.wait(0.01) else task.wait(0.03) end
    end
  end
  setStatus("Status: drop gave up after 200 cycles")
  return units
end

-- pure read: anything to drop right now? no teleport, no waits, so the
-- idle loop below never yanks the player when there is nothing to do.
-- perf: held tools first (two cheap GetChildren calls); one shared frame
-- snapshot covers all four slot checks (was up to 8 full tree walks).
local function dropHasWork()
  for _, itemName in ipairs(DropOrder) do
    if findHeldTool(itemName) then return true end
  end
  local frame, snap = snapshotFrame()
  if not frame then
    for _, itemName in ipairs(DropOrder) do
      if findItemSlot(itemName) then return true end
    end
    return false
  end
  for _, itemName in ipairs(DropOrder) do
    local slot = findItemSlotIn(frame, itemName, snap)
    if slot then return true end
  end
  return false
end

-- Scan: dumps PlayerGui tree + backpack + drop/inventory remotes into the log
-- so a mismatched GUI name can be identified. never throws.
local function scanGameGui()
  local who = "?"
  pcall(function() if LP then who = tostring(LP.Name) end end)
  say("Scan: PlayerGui of " .. who)
  local pg = getPlayerGui()
  if not pg then
    say("Scan: no PlayerGui found")
  else
    local all = nil
    pcall(function() all = pg:GetDescendants() end)
    if all then
      say("Scan: PlayerGui has " .. #all .. " descendants (first 80):")
      for i = 1, math.min(#all, 80) do
        local d = all[i]
        local extra = ""
        pcall(function()
          if d.Text then extra = " text=" .. tostring(d.Text) end
        end)
        say("  " .. d.ClassName .. " '" .. tostring(d.Name) .. "'" .. extra)
      end
    end
  end
  pcall(function()
    local pack = LP and LP.FindFirstChild and LP:FindFirstChild("Backpack")
    if pack then
      local kids = pack:GetChildren()
      say("Scan: backpack has " .. #kids .. " items:")
      for _, c in ipairs(kids) do
        say("  backpack: " .. c.ClassName .. " '" .. tostring(c.Name) .. "'")
      end
    else
      say("Scan: no Backpack")
    end
  end)
  pcall(function()
    local char = LP and LP.Character
    if char then
      for _, c in ipairs(char:GetChildren()) do
        if c.ClassName == "Tool" then
          say("  equipped: Tool '" .. tostring(c.Name) .. "'")
        end
      end
    end
  end)
  pcall(function()
    local rs = game:GetService("ReplicatedStorage")
    for _, d in ipairs(rs:GetDescendants()) do
      if d.ClassName == "RemoteEvent" or d.ClassName == "RemoteFunction" then
        local nm = string.lower(d.Name)
        if string.find(nm, "drop") or string.find(nm, "discard") or string.find(nm, "invent") then
          say("Scan remote: " .. d.ClassName .. " '" .. tostring(d.Name) .. "'")
        end
      end
    end
  end)
  say("Scan done - share the lines above")
end

