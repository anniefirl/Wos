local function getPlayerGui()
  local pg = nil
  pcall(function()
    if LP and LP.FindFirstChild then
      pg = LP:FindFirstChild("PlayerGui")
    end
  end)
  if pg == nil then
    pcall(function()
      if LP then pg = LP.PlayerGui end
    end)
  end
  return pg
