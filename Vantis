-- module loading: a real executor fetches by URL, the editor keeps a stub
-- so the main window still opens and every control stays clickable.
local function loadModule(name)
  local url = MODULE_URLS[name]
  local loader = loadstring or load
  local ok, mod = pcall(function()
    local src = game:HttpGet(url)
    return loader(src)()
  end)
  if ok and mod ~= nil then
    say(name .. " module loaded (" .. url .. ")")
    return true
  end
  say(name .. " module: display stub (full " .. name .. " logic ships with the real script)")
  return true
end

-- NPC farming: hover above hostile NPCs. never throws.
local function rootPartOf(model)
  if model == nil then return nil end
  local rp = nil
  pcall(function() rp = model:FindFirstChild("HumanoidRootPart") end)
  if rp then return rp end
  -- R6 / fallback rigs (Infinite-Yield getRoot chain)
  pcall(function() rp = model:FindFirstChild("UpperTorso") end)
  if rp then return rp end
  pcall(function() rp = model:FindFirstChild("Torso") end)
  if rp then return rp end
  pcall(function()
    for _, d in ipairs(model:GetDescendants()) do
      if d.ClassName == "Part" and d.Name == "Head" then rp = d break end
    end
  end)
  return rp
end

local function isAlive(model)
  local hum = nil
  pcall(function()
    if model.FindFirstChildOfClass then hum = model:FindFirstChildOfClass("Humanoid") end
  end)
  if hum == nil then
    pcall(function() hum = model:FindFirstChild("Humanoid") end)
  end
  if hum == nil then return true end -- no humanoid to judge by: treat as farmable
  local hp = nil
  pcall(function() hp = hum.Health end)
  return hp == nil or hp > 0
end

local function normName(s)
  s = string.lower(s or "")
  return (string.gsub(s, "[^%a%d]", ""))
end

local function namesMatch(wantNorm, modelNorm)
  if wantNorm == modelNorm then return true end
  -- wiki spells him Eisidisi / Esidisi interchangeably
  if wantNorm:find("sidisi", 1, true) and modelNorm:find("sidisi", 1, true) then
    return true
  end
  -- sewer pillar men show as plain "Pillar Man" in-game
  if wantNorm == "sewerpillarman" and modelNorm == "pillarman" then
    return true
  end
  return false
end

local function findNpcByName(name)
  local want = string.lower(name or "")
  local wantNorm = normName(name)
  local fallback = nil
  for _, d in ipairs(workspace:GetDescendants()) do
    if d.ClassName == "Model" and d.Name then
      if string.lower(d.Name) == want then
        if rootPartOf(d) then return d end
      elseif namesMatch(wantNorm, normName(d.Name)) and fallback == nil then
        if rootPartOf(d) then fallback = d end
      end
    end
  end
  return fallback
end

