-- true when the button (and its parents) are actually shown
btnUsable = function(b)
  local ok = true
  pcall(function()
    if b.Visible == false then ok = false end
  end)
  -- NOTE: Active is ignored on purpose. ImageButtons often report
  -- Active=false while still firing Activated/clicks via firesignal, and
  -- rejecting them made Conform unpressable in-game.
  pcall(function()
    local cur = b.Parent
    while cur and cur.ClassName ~= "PlayerGui" and cur.ClassName ~= "DataModel" do
      if cur.Visible == false then
        ok = false
        break
      end
      cur = cur.Parent
    end
  end)
  return ok
end

