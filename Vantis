    -- popup, wired like the real game (Drop reveals Conform, Conform drops
    -- one from the selected stack). then a real turbo pass empties it.
    do
      local pg = Instance.new("PlayerGui")
      pg.Name = "PlayerGui"
      LP.PlayerGui = pg
      local frame = Instance.new("ScreenGui")
      frame.Name = "InventoryFrame"
      frame.Enabled = true
      frame.Parent = pg
      local selectedSlot = nil
      local conform = Instance.new("TextButton")
      conform.Name = "Conform"
      conform.Text = "Conform"
      conform.Visible = false
      conform.Parent = frame
      local function makeDemoSlot(itemName, count)
        local slot = Instance.new("TextButton")
        slot.Name = itemName
        slot.Text = itemName .. " x" .. count
        slot.Parent = frame
        slot._left = count
        slot.Activated:Connect(function() selectedSlot = slot end)
        return slot
      end
