      local n = collectOrdered(myToken)
      if myToken == sweepToken then manualRunning = false end
      if cancelled(myToken) then
        say("Sweep stopped after " .. n .. " chests")
      else
        say("Sweep: visited " .. n .. " chests in order")
        Window:Notify({ Title = "Done", Text = "Sweep finished", Duration = 3 })
      end
    end)
  end,
})

