  Icon        = "radio",
  Placeholder = "OpenChest",
  Default     = "OpenChest",
  Callback    = function(text)
    if text ~= "" then Flags.RemoteName = text openRemote = nil warnedNoRemote = false end
    local r = getRemote()
    say(r and ("Remote: " .. tostring(r.Name)) or "Remote: not found, prompt-only mode")
  end,
})

local methodDropdown = FarmTab:AddDropdown({
  Title   = "Move Method",
  Icon    = "move",
  Options = {"Teleport", "Tween"},
  Default = 1,
  Callback = function(selected)
    if selected == 2 or selected == "Tween" then
      Flags.Method = "Tween"
    else
      Flags.Method = "Teleport"
    end
  end,
})

FarmTab:AddButton({
  Title    = "Collect 1-54 In Order",
  Subtitle = "One sweep: 1 then 2 then 3...",
  Icon     = "list-ordered",
  Text     = "Start 1-54",
  Callback = function()
    say("Sweep started: " .. Flags.From .. " -> " .. Flags.To .. " in order")
    local n = collectOrdered()
    say("Sweep: visited " .. n .. " chests in order")
    Window:Notify({ Title = "Done", Text = "Sweep finished", Duration = 3 })
  end,
})

FarmTab:AddButton({
  Title    = "Collect Nearest",
  Subtitle = "One chest, closest first (legacy)",
  Icon     = "mouse-pointer",
  Text     = "Collect",
  Callback = function()
    local n = collectNearestOnce()
    say("Nearest pass: " .. n .. " collected")
  end,
})

FarmTab:AddButton({
  Title    = "Rebuild Chest Cache",
  Subtitle = "Full rescan + re-resolve the remote",
  Icon     = "refresh-cw",
  Text     = "Rebuild",
  Callback = function()
    buildCache()
    openRemote = nil
    warnedNoRemote = false
    local r = getRemote()
    ensureCache()
    local n = 0
    for _ in pairs(cache) do n = n + 1 end
    say("Cache rebuilt: " .. n .. " chest(s) tracked"
      .. (r and (" | remote: " .. tostring(r.Name)) or " | remote: prompt-only"))
    if n == 0 then
      say("Hint: check From/To range and that chest models are named 1..54")
    end
    setStatus("Status: " .. n .. " chest(s) tracked")
  end,
})

FarmTab:AddSeparator()

FarmTab:AddToggleKey({
  Title    = "UI Toggle Key",
  Subtitle = "Key that hides / shows the window",
  Icon     = "keyboard",
})

console = FarmTab:AddConsole({ Title = "Activity Log", Height = 110 })
console:Write("Chest Collector 1-54 loaded (1->54 order)")
do
  local r = getRemote()
  if r then console:Write("Remote: " .. tostring(r.Name)) end
end

local SettingsTab = Window:AddTab("Settings", "settings")
SettingsTab:AddButton({
  Title    = "Unload",
  Icon     = "log-out",
  Text     = "Unload",
  Callback = function() Window:Destroy() end,
})

task.spawn(function()
  if FALLBACK then return end
  while true do
    if Flags.Auto then
      if Flags.InOrder then
        collectOrdered()
      else
        collectNearestOnce()
      end
    end
    task.wait(math.max(0.5, Flags.Delay))
  end
end)

if FALLBACK then
  if not hasAnyPrompt() then buildDemoWorld() end
  print("Demo: running one automatic 1->54 sweep so you can watch it work.")
  Flags.To = 8
  collectOrdered()
  -- simulate a respawn: chest 3 comes back
  local r3 = findModelByNum(3)
  if r3 then
    local opened = r3:FindFirstChild("Opened")
    if opened then opened.Value = false end
    disablePrompts(r3, true)
    print("Demo: chest 3 respawned - collecting it again.")
    collectOneNum(3)
  end
  -- streaming demo: chest 7's area unloads mid-run
  local m7 = findModelByNum(7)
  if m7 then
    m7.Parent = nil
    print("Demo: chest 7 streamed out (area not rendered). Going back for it.")
    collectOneNum(7)
    m7.Parent = workspace
    print("Demo: chest 7 streamed back in on approach.")
    collectOneNum(7)
  end
  if demoHidden9 then
    demoHidden9.Parent = workspace
    print("Demo: chest 9 just streamed in.")
    collectOneNum(9)
  end
  print("Demo done: " .. uniqueOpened .. " unique chests, " .. totalOpens .. " total opens.")
end

