-- VantixUI load (real) or fallback shim (editor mock)
local VantixUI = nil
do
  local ok, lib = pcall(function()
    local src = game:HttpGet("https://raw.githubusercontent.com/Snipez-Dev/Vantix/refs/heads/main/VantixUI6")
    return loadstring(src)()
  end)
  if ok and type(lib) == "table" and type(lib.CreateWindow) == "function" then
    VantixUI = lib
  end
end
local FALLBACK = (VantixUI == nil)

if FALLBACK then
  local function newSignal()
    local sig = { _cons = {} }
    function sig:Connect(fn)
      table.insert(sig._cons, fn)
      return { Connected = true, Disconnect = function() end }
    end
    function sig:Fire(...)
      for _, fn in ipairs(sig._cons) do pcall(fn, ...) end
    end
    return sig
  end
  local function makeElement(def)
    local el = { _value = def.Default, Changed = newSignal() }
    function el:Get() return el._value end
    function el:Set(v)
      el._value = v
      el.Changed:Fire(v)
      if def.Callback then def.Callback(v) end
    end
    function el:SetOptions(opts) el._options = opts end
    function el:Press() if def.Callback then def.Callback() end end
    function el:Write(msg) print("[log] " .. tostring(msg)) end
    function el:Clear() print("[log] cleared") end
    function el:Lock(_) el._locked = true end
    function el:Unlock() el._locked = false end
    function el:IsLocked() return el._locked == true end
    return el
  end
  local function makeTab(name)
    print("[ui] tab '" .. tostring(name) .. "' ready")
    local tab = {}
    function tab:AddToggle(def) return makeElement(def) end
    function tab:AddSlider(def) return makeElement(def) end
    function tab:AddButton(def) return makeElement(def) end
    function tab:AddDropdown(def) return makeElement(def) end
    function tab:AddLabel(text, _) return makeElement({ Default = text }) end
    function tab:AddConsole(_) return makeElement({}) end
    function tab:AddSeparator() end
    function tab:AddToggleKey(_) return makeElement({}) end
    function tab:AddKeybind(_) return makeElement({}) end
    function tab:AddTextBox(def) return makeElement(def) end
    return tab
  end
  local ui = {}
  function ui:CreateWindow(def)
    print("[ui] window '" .. tostring(def.Title) .. "' ready (fallback mode, no real rendering)")
    local win = {}
    function win:AddTab(name, _) return makeTab(name) end
    function win:CreateTag(...) end
    function win:Notify(n) print("Notify [" .. tostring(n.Title) .. "] " .. tostring(n.Text)) end
    function win:SetToggleKey(_) end
    function win:GetToggleKey() return { Name = "RightShift" } end
    function win:Minimize() end
    function win:Restore() end
    function win:Toggle() end
    function win:IsMinimized() return false end
    function win:Destroy() print("[ui] window destroyed") end
    win.Gui = nil
    return win
  end
  VantixUI = ui
end

if FALLBACK then
  -- demo "game server": opening happens through the PROMPT, like the real game.
  -- NOTE: the server only flips Opened + disables the prompt. Counting lives
  -- in collectOneNum so we never double-count in the mock.
  ensureDemoRemote()
  local function serverOpen(player, chest)
    if typeof(chest) ~= "Instance" or not chest.FindFirstChild then
      return
    end
    local ok, opened = pcall(function() return chest:FindFirstChild("Opened") end)
    if not ok or not opened or opened.Value then
      return
    end
    local hrp = getHRP()
    local part = chest:FindFirstChild("ChestPart", true)
    if hrp and part then
      if dist3(hrp.Position, part.Position) > 60 then
        print("Server: " .. tostring(player.Name) .. " too far from chest " .. tostring(chest.Name))
        return
      end
    end
    opened.Value = true
    disablePrompts(chest, false)
    print("Server: opened chest " .. tostring(chest.Name))
  end
  local demoRem = getRemote()
  if demoRem then
    demoRem.OnServerEvent:Connect(function(player, chest)
      if typeof(chest) == "Instance" then serverOpen(player, chest) end
    end)
  end
  -- prompt trigger also opens (this is the path the new collector uses).
  -- handles prompts added directly AND prompts nested inside added models.
  local function hookPrompt(p)
    if not p or p.ClassName ~= "ProximityPrompt" then return end
    if p._serverHooked then return end
    p._serverHooked = true
    p.Triggered:Connect(function(player)
      local m = modelOf(p)
      if m then serverOpen(player, m) end
    end)
  end
  task.spawn(function()
    task.wait(0.1)
    for _, d in ipairs(workspace:GetDescendants()) do
      if d.ClassName == "ProximityPrompt" then hookPrompt(d) end
    end
    workspace.DescendantAdded:Connect(function(d)
      if d.ClassName == "ProximityPrompt" then
        hookPrompt(d)
      else
        -- a whole chest model was added: hook any prompts inside it
        local ok, desc = pcall(function() return d:GetDescendants() end)
        if ok and desc then
          for _, x in ipairs(desc) do
            if x.ClassName == "ProximityPrompt" then hookPrompt(x) end
          end
        end
        if d.ClassName == "Model" and tonumber(d.Name) then
          local ok2, pr = pcall(function() return d:FindFirstChild("ProximityPrompt", true) end)
          -- FindFirstChild with recursive may return the prompt; hook via descendants above
          if ok2 and pr then hookPrompt(pr) end
        end
      end
    end)
  end)
end

